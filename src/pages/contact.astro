---
import Layout from "@layouts/Layout.astro";
import Hero from "@sections/contact/Hero.astro";
import ContactForm from "@sections/contact/ContactForm.astro";
import Sidebar from "@sections/contact/Sidebar.astro";
---

<Layout title="Contact | Akmal Keisin" description="Contact Akmal Keisin, a full-stack developer in Semarang, Indonesia, about a project, role, or collaboration.">
  <Hero />
  <div class="mx-auto max-w-6xl px-6 pb-24 sm:px-8">
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,360px)]">
      <ContactForm />
      <Sidebar />
    </div>
  </div>
</Layout>