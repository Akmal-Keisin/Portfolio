---
import Layout from "@layouts/Layout.astro";
import Hero from "@sections/article/Hero.astro";
import Toolbar from "@components/layout/ArchiveToolbar.astro";
import FeaturedArticle from "@sections/article/FeaturedArticle.astro";
import ArticleGrid from "@sections/article/ArticleGrid.astro";
import Pagination from "@sections/article/Pagination.astro";
import { getArticles } from "@lib/api";
import type { Article, PaginatedResource } from "@sections/article/data";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const filter = Astro.url.searchParams.get("category") ?? "";
const filtered = Boolean(query || filter);
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;

let unavailable = false;
let articles: PaginatedResource<Article> = {
  data: [],
  meta: {
    current_page: 1,
    last_page: 1,
    total: 0,
    per_page: 15,
    path: "/article",
    from: null,
    to: null,
  },
  links: { first: "", last: "", prev: null, next: null },
};

try {
  articles = await getArticles(page, { q: query, category: filter, include_filters: "1" });
} catch (error) {
  unavailable = true;
  console.error("Failed to fetch articles:", error);
}

const featured = articles.data.length > 0 ? articles.data[0] : null;
---

<Layout page={page} title="Articles | Akmal Keisin" description="Read Akmal Keisin’s notes on backend engineering, databases, and full-stack web development.">
  <Hero
    total={unavailable ? undefined : articles.meta.total}
    categoriesCount={filtered ? undefined : articles.filters?.length}
  />
  {unavailable ? (
    <div class="mx-auto max-w-6xl px-6 py-16 sm:px-8">
      <p class="text-ink-soft">The article archive is temporarily unavailable.</p>
      <a class="mt-4 inline-block text-accent underline underline-offset-4" href="/skills">Explore my technology stack</a>
    </div>
  ) : (
    <>
      <Toolbar kind="article" field="category" options={articles.filters ?? []} query={query} filter={filter} total={articles.meta.total} />
      {featured && <FeaturedArticle featured={featured} />}
      <ArticleGrid filtered={filtered} articles={articles} />
      <Pagination articles={articles} />
    </>
  )}
</Layout>
