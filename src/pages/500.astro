---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/layout/SectionContainer.astro";
import Button from "../components/ui/Button.astro";
---

<Layout title="Server error | Akmal Keisin">
  <main>
    <SectionContainer class="flex min-h-[55vh] flex-col justify-center">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ink-soft">Error 500</p>
      <h1
        class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
      >
        Something broke on our end.
      </h1>
      <p class="mt-4 max-w-md text-base leading-relaxed text-ink-soft">
        This one is on me. Try again in a moment, or head back home.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/">Back home</Button>
      </div>
    </SectionContainer>
  </main>
</Layout>
