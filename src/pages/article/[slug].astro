---
import Layout from "@layouts/Layout.astro";
import Badge from "@components/ui/Badge.astro";
import Icon from "@components/ui/Icon.astro";
import { getArticleBySlug } from "@lib/api";
import { formatDate, CATEGORY_COLORS } from "@sections/article/data";

import { generateHTML } from "@tiptap/html";
import StarterKit from "@tiptap/starter-kit";

const { slug } = Astro.params;

let article;
let contentHtml = "";

if (slug) {
  try {
    article = await getArticleBySlug(slug);

    if (article.content) {
      contentHtml = generateHTML(article.content, [StarterKit]);
    }
  } catch (error) {
    console.error(`Failed to fetch article with slug: ${slug}`, error);
  }
}

if (!article) {
  return Astro.redirect("/404");
}

const categoryClass =
  CATEGORY_COLORS[article.category.name] ?? "bg-surface text-ink-soft border-ink/10";
---

<Layout title={`${article.title} | Akmal Keisin`}>
  <main class="py-20 sm:py-24">
    <div class="mx-auto max-w-2xl px-6">
      <a
        href="/article"
        class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-ink-soft transition-colors hover:text-ink"
      >
        <Icon name="arrow-left" class="h-3.5 w-3.5" />
        All articles
      </a>

      <header class="mt-8">
        <div class="flex flex-wrap items-center gap-3">
          <span class:list={["rounded-full border px-3 py-1 font-mono text-xs", categoryClass]}>
            {article.category.name}
          </span>
          <span class="font-mono text-xs text-ink-soft">{formatDate(article.createdAt)}</span>
        </div>
        <h1
          class="mt-6 font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl"
        >
          {article.title}
        </h1>
        <p class="mt-4 text-sm text-ink-soft">By {article.author}</p>
      </header>

      <article
        class="prose prose-lg mt-12 max-w-none prose-headings:font-display prose-headings:tracking-tight prose-headings:text-ink prose-p:text-ink-soft prose-a:text-article-deep prose-strong:text-ink prose-blockquote:border-article prose-blockquote:text-ink-soft prose-code:text-ink"
        set:html={contentHtml}
      />

      {
        article.tags?.length ? (
          <footer class="mt-14 border-t border-ink/10 pt-8">
            <div class="flex flex-wrap gap-2">
              {article.tags.map((tag) => (
                <Badge variant="article">#{tag.name}</Badge>
              ))}
            </div>
          </footer>
        ) : null
      }
    </div>
  </main>
</Layout>
