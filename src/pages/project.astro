---
import Layout from "@layouts/Layout.astro";
import Hero from "@sections/project/Hero.astro";
import Toolbar from "@components/layout/ArchiveToolbar.astro";
import ProjectGrid from "@sections/project/ProjectGrid.astro";
import Pagination from "@sections/project/Pagination.astro";
import { getProjects } from "@lib/api";
import type { PaginatedResource, Project } from "@lib/api";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const filter = Astro.url.searchParams.get("stack") ?? "";
const filtered = Boolean(query || filter);
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;

let options: string[] = [];
let projects: Project[] = [];
let unavailable = false;
let meta: PaginatedResource<Project>["meta"] = {
  current_page: 1,
  last_page: 1,
  total: 0,
  per_page: 15,
  path: "/project",
  from: null,
  to: null,
};
let links: PaginatedResource<Project>["links"] = {
  first: "",
  last: "",
  prev: null,
  next: null,
};

try {
  const response = await getProjects(page, { q: query, stack: filter, include_filters: "1" });
  if (response && response.data) {
    options = response.filters ?? [];
    projects = response.data;
    meta = response.meta;
    links = response.links;
  }
} catch (error) {
  unavailable = true;
  console.error("Failed to fetch projects:", error);
}
---

<Layout page={page} title="Projects | Akmal Keisin" description="Explore web software projects by Akmal Keisin, including the technologies used and links to live projects and source code where available.">
  <Hero total={unavailable ? undefined : meta.total} />
  {unavailable ? (
    <div class="mx-auto max-w-6xl px-6 py-16 sm:px-8">
      <p class="text-ink-soft">The project archive is temporarily unavailable.</p>
      <a class="mt-4 inline-block text-accent underline underline-offset-4" href="/about#experience">Explore my professional work</a>
    </div>
  ) : (
    <>
      <Toolbar kind="project" field="stack" options={options} query={query} filter={filter} total={meta.total} />
      <ProjectGrid filtered={filtered} projects={projects} />
      <Pagination meta={meta} links={links} />
    </>
  )}
</Layout>
