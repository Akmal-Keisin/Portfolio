---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const principles = [
  { title: "Accessibility First", desc: "Everyone deserves great software. I prioritize semantic HTML and WCAG standards to ensure my work is inclusive.", icon: "leaf" },
  { title: "Deep Understanding", desc: "I believe in learning the fundamentals before frameworks. Understanding the 'how' and 'why' makes for better architectural decisions.", icon: "leaf" },
  { title: "Continuous Learning", desc: "The modern tech stack shifts constantly. My autodidactic mindset drives me to master new systems through disciplined study.", icon: "leaf" },
  { title: "Ship Iteratively", desc: "I favor getting code into production early and improving it through real-world usage and feedback loops.", icon: "leaf" },
];

const experience = [
  {
    period: "Jun 2024 – Now",
    role: "Web Developer",
    org: "Reprime ID",
    stacks: ["PHP", "Laravel", "MySQL", "PostgreSQL", "TypeScript", "Vue", "Go", "Fiber", "Astro"],
    note: "Returned with more experience. Focus on developing the new version of the core product, optimizing performance, and architecting scalable backend systems.",
    current: true,
  },
  {
    period: "Oct 2023 – Jun 2024",
    role: "Web Developer",
    org: "Crocodic",
    stacks: ["PHP", "Laravel", "MySQL", "TypeScript"],
    note: "Engineered a complex HR project for a large factory client with thousands of active daily users. Managed intricate payroll logic and shift scheduling systems.",
    current: false,
  },
  {
    period: "Sep 2022 – Sep 2023",
    role: "Web Developer",
    org: "Reprime ID",
    stacks: ["PHP", "Laravel", "Lumen", "PostgreSQL", "MySQL"],
    note: "Full developer role post-internship. Responsible for new feature delivery, infrastructure maintenance, and resolving critical production bugs.",
    current: false,
  },
  {
    period: "Jun 2022 – Aug 2022",
    role: "Intern",
    org: "Reprime ID",
    stacks: ["PHP", "Laravel", "MySQL"],
    note: "Gained hands-on experience in production environments, contributing to feature updates and learning enterprise development best practices.",
    current: false,
  },
];
---

<Layout title="About — Akmal Keisin">
  <Navbar />

  <!-- ── Dark Library Hero ─────────────────────────────────────────────────── -->
  <section class="relative bg-moss-800 overflow-hidden pt-[66px]" aria-label="About hero">
    <!-- Background textures -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-[.04]">
        <defs>
          <pattern id="hex-about" x="0" y="0" width="60" height="52" patternUnits="userSpaceOnUse">
            <path d="M30 2L56 17V47L30 62L4 47V17Z" fill="none" stroke="#c8f0d0" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#hex-about)" />
      </svg>
      <div class="absolute top-0 right-0 w-120 h-120 rounded-full bg-moss-600/20 blur-3xl" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full bg-mint/10 blur-3xl" aria-hidden="true"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-6 py-24 md:py-32">
      <div class="reveal">
        <span class="block w-12 h-[3px] rounded-full mb-6 bg-gradient-to-r from-mint to-moss-500"></span>
        <p class="text-label-mono text-moss-300 mb-4">My Story</p>
        <h1 class="text-hero-title text-fog">
          More than<br/><em class="not-italic text-mint">just a learner</em>
        </h1>
        <div class="grid lg:grid-cols-2 gap-12 mt-12">
          <p class="text-hero-subtitle text-moss-300">
            I'm <strong class="text-mint font-semibold">Akmal Keisin</strong>, a full-stack developer with three years of experience turning complex problems into elegant, maintainable software. I started building websites at 18 and never stopped.
          </p>
          <p class="text-section-desc text-moss-400">
            The modern tech stack shifts constantly. Mastering it requires an autodidactic mindset — driven by continuous learning and highly disciplined study. True expertise means understanding how the underlying systems work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Principles & Philosophy ───────────────────────────────────────────── -->
  <main class="bg-fog">
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32">
      <section class="mb-32">
        <div class="reveal mb-16 flex flex-col md:flex-row md:items-end gap-6">
          <div class="md:w-1/2">
            <h2 class="text-section-title text-ink mb-4">Engineering <em class="text-moss-500">Principles</em></h2>
            <p class="text-section-desc text-moss-600 max-w-md">
              Guidelines I follow to ensure every project is robust, inclusive, and scalable.
            </p>
          </div>
          <div class="flex-1 h-px bg-sage-200 mb-2 hidden md:block"></div>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {principles.map((p, i) => (
            <div class={`reveal d${i+1} bg-white border border-sage-200 rounded-3xl p-8 hover:shadow-lg transition-all duration-300`}>
              <div class="flex gap-4 items-start">
                <div class="w-10 h-10 bg-mint/20 rounded-xl flex items-center justify-center shrink-0">
                  <svg width="20" height="20" viewBox="0 0 18 18" fill="none">
                    <path d="M9 2C9 2 3 5 3 10C3 13 5.7 15.5 9 15.5C12.3 15.5 15 13 15 10C15 5 9 2 9 2Z" fill="#3e7d32" opacity="0.2"/>
                    <path d="M6 9.5L8 11.5L12 7.5" stroke="#3e7d32" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-card-title text-ink mb-2">{p.title}</h3>
                  <p class="font-body text-sm text-moss-600 leading-relaxed">{p.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Work History ───────────────────────────────────────────────────── -->
      <section class="mb-32">
        <div class="reveal mb-16 flex flex-col md:flex-row md:items-end gap-6">
          <div class="md:w-1/2">
            <h2 class="text-section-title text-ink mb-4">Work <em class="text-moss-500">History</em></h2>
            <p class="text-section-desc text-moss-600 max-w-md">
              A journey through the roles and projects that shaped my expertise.
            </p>
          </div>
          <div class="flex-1 h-px bg-sage-200 mb-2 hidden md:block"></div>
        </div>

        <div class="space-y-6">
          {experience.map((item, i) => (
            <div class={`reveal reveal-d${i+1} proj-card relative flex flex-col md:flex-row justify-between gap-8 rounded-3xl p-8 border shadow-sm transition-all duration-500
              ${item.current
                ? "bg-moss-800 border-moss-600"
                : "bg-white border-sage-200 hover:border-moss-300"
              }`}>

              <div class="flex-1">
                <div class="flex items-center gap-3 mb-4">
                  <span class={`text-label-mono border px-3 py-1 rounded-full ${item.current ? "text-mint border-moss-500 bg-moss-700/60" : "text-moss-400 border-sage-200 bg-fog"}`}>
                    {item.period}
                  </span>
                  {item.current && (
                    <span class="flex items-center gap-1.5 bg-mint/10 px-3 py-1 rounded-full">
                      <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-mint"></span>
                      </span>
                      <span class="text-label-mono text-mint">Currently Active</span>
                    </span>
                  )}
                </div>

                <h3 class={`text-card-title mb-2 ${item.current ? "text-fog" : "text-ink"}`}>
                  {item.role} <span class={item.current ? "text-moss-400" : "text-moss-400"}>at</span> {item.org}
                </h3>
                <p class={`text-section-desc max-w-3xl mb-6 ${item.current ? "text-moss-300" : "text-moss-600"}`}>
                  {item.note}
                </p>

                <div class="flex flex-wrap gap-2">
                  {item.stacks.map((s) => (
                    <span class={`text-label-mono px-3 py-1 rounded-full border
                      ${item.current
                        ? "text-mint border-moss-500 bg-moss-700/40"
                        : "text-moss-600 border-sage-100 bg-fog"
                      }`}>
                      {s}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Education ──────────────────────────────────────────────────────── -->
      <section class="reveal">
        <div class="bg-moss-800 rounded-[3rem] p-12 md:p-20 text-center relative overflow-hidden">
          <div class="absolute inset-0 hex-pattern opacity-[.03] pointer-events-none"></div>
          <div class="flex flex-col items-center">
            <div class="text-label-mono text-mint mb-6">Foundation</div>
            <h2 class="text-hero-title text-fog mb-8">Education</h2>
            <div class="max-w-md mx-auto">
              <div class="text-label-mono text-moss-400 mb-2">2019 – 2022</div>
              <div class="text-card-title text-fog font-medium mb-1">Multimedia</div>
              <div class="text-hero-subtitle text-moss-300">SMKN 11 Semarang</div>
            </div>
            <div class="flex flex-wrap justify-center gap-3 mt-12">
              {["UI Design", "Photography", "Full-stack Dev", "Database Architecture"].map((t) => (
                <span class="text-label-mono text-mint border border-moss-600/60 bg-moss-700/40 px-6 py-3 rounded-full">
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <!-- ── CTA Section ───────────────────────────────────────────────────────── -->
  <section class="bg-fog py-24 px-6 text-center">
    <div class="reveal">
      <h2 class="text-section-title text-ink mb-8">Want to know more?<br/><em class="not-italic text-moss-500 underline decoration-mint/40 decoration-4">Let's talk.</em></h2>
      <a
        href="/#contact"
        class="inline-flex items-center gap-3 bg-moss-700 text-fog font-semibold text-sm px-10 py-4 rounded-full hover:bg-ink transition-all shadow-lg hover:shadow-2xl"
      >
        Send a message
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
