---
import Layout from "@layouts/Layout.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Icon from "@components/ui/Icon.astro";
import { getProjectBySlug } from "@lib/api";

const { slug } = Astro.params;

let project;

if (slug) {
  try {
    project = await getProjectBySlug(slug);
  } catch (error) {
    console.error(`Failed to fetch project with slug: ${slug}`, error);
  }
}

if (!project) {
  return Astro.redirect("/404");
}

const statusVariant = (
  { completed: "exp", ongoing: "folio", archived: "neutral" } as const
)[project.status as "completed" | "ongoing" | "archived"] ?? "neutral";
---

<Layout title={`${project.title} | Akmal Keisin`}>
  <main class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6 sm:px-8">
      <a
        href="/project"
        class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-ink-soft transition-colors hover:text-ink"
      >
        <Icon name="arrow-left" class="h-3.5 w-3.5" />
        All projects
      </a>

      <div
        class:list={[
          "mt-10 grid gap-12",
          project.thumbnail && "lg:grid-cols-2 lg:items-start",
        ]}
      >
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <Badge variant="folio">{project.tech_stacks[0]?.name ?? "Project"}</Badge>
            <Badge variant={statusVariant}>{project.status}</Badge>
          </div>

          <h1
            class="mt-6 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
          >
            {project.title}
          </h1>

          <div
            class="prose prose-lg mt-8 max-w-none prose-headings:font-display prose-headings:text-ink prose-p:text-ink-soft prose-a:text-folio-deep prose-strong:text-ink prose-code:text-ink"
            set:html={project.description}
          />

          {
            project.tech_stacks.length > 0 && (
              <div class="mt-10">
                <p class="font-mono text-xs uppercase tracking-[0.18em] text-ink-soft">
                  Technology
                </p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tech_stacks.map((tech) => (
                    <Badge variant="neutral">{tech.name}</Badge>
                  ))}
                </div>
              </div>
            )
          }

          {
            (project.live_url || project.repo_url) && (
              <div class="mt-10 flex flex-wrap gap-3 border-t border-ink/10 pt-8">
                {project.live_url && (
                  <Button href={project.live_url}>
                    Live project
                    <Icon name="external-link" class="h-4 w-4" />
                  </Button>
                )}
                {project.repo_url && (
                  <Button href={project.repo_url} variant="secondary">
                    View source
                    <Icon name="github" class="h-4 w-4" />
                  </Button>
                )}
              </div>
            )
          }
        </div>

        {
          project.thumbnail && (
            <div class="lg:sticky lg:top-28">
              <img
                src={project.thumbnail}
                alt={`Screenshot of ${project.title}`}
                class="w-full rounded-2xl border border-ink/10 object-cover"
                loading="lazy"
              />
            </div>
          )
        }
      </div>
    </div>
  </main>
</Layout>
