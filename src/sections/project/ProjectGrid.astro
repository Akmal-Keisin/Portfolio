---
import type { Project } from "@lib/api";
import { STATUS_COLORS } from "./data";
import Icon from "../../components/ui/Icon.astro";

interface Props {
  projects: Project[];
}

const { projects = [] } = Astro.props;
const featured = projects.find((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
const isEmpty = projects.length === 0;
---

<div class="mx-auto max-w-6xl px-6 py-14 sm:px-8">
  {
    featured && (
      <section
        class="mb-16"
        data-tech-stacks={featured.tech_stacks.map((t) => t.name).join(",")}
        data-title={featured.title.toLowerCase()}
      >
        <div
          class:list={[
            "group grid overflow-hidden rounded-2xl border border-ink/10 bg-canvas transition-colors hover:border-folio/40",
            featured.thumbnail && "lg:grid-cols-2",
          ]}
        >
          {featured.thumbnail && (
            <div class="relative border-b border-ink/10 lg:border-b-0 lg:border-r">
              <img
                src={featured.thumbnail}
                alt={`Screenshot of ${featured.title}`}
                loading="lazy"
                class="h-64 w-full object-cover lg:h-full"
              />
            </div>
          )}

          <div class="flex flex-col justify-between p-8 lg:p-12">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-folio-tint px-3 py-1 font-mono text-xs text-folio-deep">
                  <Icon name="star" class="h-3 w-3" />
                  Featured
                </span>
                <span class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-canvas px-3 py-1 font-mono text-xs capitalize text-ink-soft">
                  <span class:list={["h-2 w-2 rounded-full", STATUS_COLORS[featured.status]]} />
                  {featured.status}
                </span>
                <span class="rounded-full border border-ink/10 bg-surface px-3 py-1 font-mono text-xs text-ink-soft">
                  {featured.tech_stacks[0]?.name || "Project"}
                </span>
              </div>

              <h2 class="mt-6 font-display text-3xl font-semibold leading-snug text-ink transition-colors group-hover:text-folio-deep">
                {featured.title}
              </h2>
              <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">
                {featured.excerpt}
              </p>

              <div class="mt-6 flex flex-wrap gap-2">
                {featured.tech_stacks.map((s) => (
                  <span class="rounded-full border border-ink/10 px-3 py-1 font-mono text-xs text-ink-soft">
                    {s.name}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-ink/10 pt-6">
              <a
                href={`/project/${featured.slug}`}
                class="inline-flex items-center gap-2 text-sm font-semibold text-folio-deep"
              >
                View project
                <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </a>
              <div class="flex items-center gap-5">
                {featured.repo_url && (
                  <a
                    href={featured.repo_url}
                    class="text-ink-soft transition-colors hover:text-ink"
                    title="View source"
                    aria-label={`${featured.title} source code`}
                  >
                    <Icon name="github" class="h-5 w-5" />
                  </a>
                )}
                {featured.live_url && (
                  <a
                    href={featured.live_url}
                    class="text-ink-soft transition-colors hover:text-ink"
                    title="Live project"
                    aria-label={`${featured.title} live project`}
                  >
                    <Icon name="external-link" class="h-5 w-5" />
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section>
    <div id="grid-container" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((project) => (
          <div
            class="group flex flex-col rounded-xl border border-ink/10 bg-canvas p-6 transition-colors hover:border-folio/40"
            data-tech-stacks={project.tech_stacks.map((t) => t.name).join(",")}
            data-title={project.title.toLowerCase()}
          >
            <div class="flex flex-1 flex-col">
              <div class="flex items-center justify-between gap-3">
                <span class="rounded-full border border-ink/10 px-3 py-1 font-mono text-xs text-ink-soft transition-colors group-hover:border-folio/40 group-hover:text-folio-deep">
                  {project.tech_stacks[0]?.name || "Project"}
                </span>
                <span
                  class:list={["h-2 w-2 rounded-full", STATUS_COLORS[project.status]]}
                  title={project.status}
                />
              </div>

              <h3 class="mt-5 font-display text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-folio-deep">
                {project.title}
              </h3>
              <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-ink-soft">
                {project.excerpt}
              </p>

              <div class="mt-6 flex flex-wrap gap-2">
                {project.tech_stacks.slice(0, 4).map((s) => (
                  <span class="font-mono text-xs text-ink-soft">{s.name}</span>
                ))}
              </div>

              <div class="mt-6 flex items-center justify-between border-t border-ink/10 pt-4">
                <span class="font-mono text-xs capitalize text-ink-soft">{project.status}</span>
                <div class="flex items-center gap-4">
                  {project.repo_url && (
                    <a
                      href={project.repo_url}
                      class="text-ink-soft transition-colors hover:text-ink"
                      title="View source"
                      aria-label={`${project.title} source code`}
                    >
                      <Icon name="github" class="h-4 w-4" />
                    </a>
                  )}
                  <a
                    href={`/project/${project.slug}`}
                    class="text-ink-soft transition-colors hover:text-folio-deep"
                    aria-label={`Read more about ${project.title}`}
                  >
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div id="empty-state" class={`${isEmpty ? "block" : "hidden"} py-24 text-center`}>
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-folio-tint">
        <Icon name="search" class="h-6 w-6 text-folio-deep" />
      </div>
      <h3 class="font-display text-2xl font-semibold text-ink">
        {isEmpty ? "No projects yet" : "No projects found"}
      </h3>
      <p class="mt-2 text-sm text-ink-soft">
        {
          isEmpty
            ? "New work is on the way. Check back soon."
            : "Try a different search term or tech-stack filter."
        }
      </p>
    </div>
  </section>
</div>
