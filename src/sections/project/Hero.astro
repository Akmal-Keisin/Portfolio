---
import type { Project } from "@lib/api";

interface Props {
  projects: Project[];
  total: number;
}

const { total = 0 } = Astro.props;
---

<section
  id="top"
  class="scroll-mt-20 border-b border-ink/10 bg-canvas"
  aria-label="Selected work"
>
  <div class="mx-auto max-w-6xl px-6 pb-12 pt-16 sm:px-8 sm:pb-16 sm:pt-20">
    <p class="font-mono text-sm uppercase tracking-[0.3em] text-ink-soft">Selected work</p>

    <h1
      class="mt-4 max-w-3xl font-display text-5xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-6xl"
    >
      Things I've shipped
    </h1>

    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
      Products, tools, and systems I've built professionally and on my own time. {total} projects listed.
    </p>
  </div>
</section>
