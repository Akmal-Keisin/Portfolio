---
import type { PaginatedResource } from "@lib/api";
import Icon from "../../components/ui/Icon.astro";

interface Props {
  meta: PaginatedResource<any>["meta"];
  links: PaginatedResource<any>["links"];
}

const { meta, links } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 pb-24 sm:px-8">
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-ink/10 pt-8">
    <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">
      Page {meta.current_page} of {meta.last_page}, {meta.total} total
    </span>

    <div class="flex items-center gap-1.5">
      <a
        href={links.prev ?? undefined}
        class={`inline-flex h-10 w-10 items-center justify-center rounded-lg border transition-colors no-underline ${links.prev ? "border-ink/10 bg-canvas text-ink hover:border-ink/25 hover:bg-surface" : "pointer-events-none cursor-not-allowed border-ink/5 text-ink-soft/40"}`}
        aria-disabled={links.prev === null}
        aria-label="Previous page"
      >
        <Icon name="chevron-left" class="h-4 w-4" />
      </a>

      {
        Array.from({ length: meta.last_page }, (_, i) => i + 1).map((p) => (
          <a
            href={`${meta.path}?page=${p}`}
            class={`inline-flex h-10 w-10 items-center justify-center rounded-lg border font-mono text-xs transition-colors no-underline ${p === meta.current_page ? "border-ink bg-ink text-canvas" : "border-ink/10 bg-canvas text-ink-soft hover:border-ink/25 hover:text-ink"}`}
            aria-current={p === meta.current_page ? "page" : undefined}
          >
            {p}
          </a>
        ))
      }

      <a
        href={links.next ?? undefined}
        class={`inline-flex h-10 w-10 items-center justify-center rounded-lg border transition-colors no-underline ${links.next ? "border-ink/10 bg-canvas text-ink hover:border-ink/25 hover:bg-surface" : "pointer-events-none cursor-not-allowed border-ink/5 text-ink-soft/40"}`}
        aria-disabled={links.next === null}
        aria-label="Next page"
      >
        <Icon name="chevron-right" class="h-4 w-4" />
      </a>
    </div>

    <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">
      {meta.per_page} per page
    </span>
  </div>
</section>
