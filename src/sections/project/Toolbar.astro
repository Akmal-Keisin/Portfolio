---
import type { Project } from "@lib/api";
import Icon from "../../components/ui/Icon.astro";

interface Props {
  projects: Project[];
}

const { projects = [] } = Astro.props;
const techStacks = [
  "All",
  ...new Set(projects.flatMap((p) => p.tech_stacks.map((t) => t.name))),
];
---

<section class="sticky top-[69px] z-40 border-b border-ink/10 bg-canvas/90 backdrop-blur">
  <div class="mx-auto max-w-6xl px-6 py-3 sm:px-8">
    <div class="flex flex-wrap items-center gap-3">
      <div class="relative min-w-[200px] max-w-[300px] flex-1">
        <Icon
          name="search"
          class="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-ink-soft"
        />
        <input
          type="text"
          id="search-input"
          placeholder="Search projects"
          class="w-full rounded-full border border-ink/15 bg-canvas py-2 pl-8 pr-3 font-mono text-xs text-ink placeholder:text-ink-soft focus:border-accent"
        />
      </div>

      <div class="flex flex-wrap items-center gap-1.5">
        {
          techStacks.map((stack) => (
            <button
              class="filter-btn cursor-pointer rounded-full border border-ink/10 bg-canvas px-3.5 py-1.5 font-mono text-xs text-ink-soft transition-colors hover:border-ink/25 hover:text-ink data-[active=true]:border-ink data-[active=true]:bg-ink data-[active=true]:text-canvas"
              data-filter={stack}
              data-active={stack === "All" ? "true" : "false"}
            >
              {stack}
            </button>
          ))
        }
      </div>

      <div class="ml-auto hidden sm:block">
        <span id="result-count" class="font-mono text-xs text-ink-soft">
          {projects.length} shown
        </span>
      </div>
    </div>
  </div>
</section>
