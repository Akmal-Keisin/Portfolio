---
interface Props {
  total: number;
  totalPages: number;
  categoriesCount: number;
}

const { total, categoriesCount } = Astro.props;
---

<section id="article" class="scroll-mt-20 border-b border-ink/10 bg-canvas">
  <div class="mx-auto max-w-6xl px-6 pb-12 pt-16 sm:px-8 sm:pb-16 sm:pt-20">
    <p class="font-mono text-sm uppercase tracking-[0.3em] text-ink-soft">Writing</p>

    <h1
      class="mt-4 max-w-3xl font-display text-5xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-6xl"
    >
      From the notebook
    </h1>

    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
      Notes and deep dives on backend engineering, databases, and the web stack.
    </p>

    <p class="mt-4 font-mono text-xs uppercase tracking-widest text-ink-soft">
      {total} articles across {categoriesCount} categories
    </p>
  </div>
</section>
