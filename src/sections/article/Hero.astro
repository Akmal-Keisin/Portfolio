---
import { dummyArticles } from "./data";

const articles = dummyArticles;
const categories = ["All", ...new Set(articles.data.map(a => a.category))];
---
<section class="relative bg-moss-800 overflow-hidden pt-[66px]" aria-label="Articles hero">
  <!-- Background textures -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <svg class="absolute inset-0 w-full h-full opacity-[.04]">
      <defs>
        <pattern id="hex-hero" x="0" y="0" width="60" height="52" patternUnits="userSpaceOnUse">
          <path d="M30 2L56 17V47L30 62L4 47V17Z" fill="none" stroke="#c8f0d0" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hex-hero)" />
    </svg>
    <div class="absolute top-0 right-0 w-96 h-96 rounded-full bg-moss-600/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full bg-mint/10 blur-3xl" aria-hidden="true"></div>
    <svg class="absolute top-16 right-[15%] w-16 opacity-[.07]" viewBox="0 0 80 120" fill="none">
      <path d="M40 10C40 10 10 40 10 70C10 88 23 100 40 100C57 100 70 88 70 70C70 40 40 10 40 10Z" fill="#c8f0d0"/>
      <line x1="40" y1="100" x2="40" y2="115" stroke="#c8f0d0" stroke-width="2"/>
    </svg>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 md:py-28">
    <!-- Eyebrow + heading -->
    <div class="reveal mb-12">
      <span class="block w-12 h-[3px] rounded-full mb-6 bg-gradient-to-r from-mint to-moss-500"></span>
      <p class="text-label-mono text-moss-300 mb-4">Writing</p>
      <h1 class="text-hero-title text-fog">
        From the<br/><em class="not-italic text-mint">notebook</em>
      </h1>
      <p class="text-hero-subtitle text-moss-300 mt-8 max-w-xl">
        Notes, deep-dives, and tutorials on backend engineering, database internals, and the web stack.
      </p>
    </div>

    <!-- Stats row -->
    <div class="flex items-center gap-8 md:gap-12 pt-10 border-t border-moss-700/50">
      {[
        [String(articles.meta.total), "Articles"],
        [String(articles.meta.last_page), "Pages"],
        [String(categories.length - 1), "Categories"],
      ].map(([num, label], i) => (
        <div class={`reveal d${i + 1}`}>
          <div class="text-hero-title text-fog">{num}</div>
          <div class="text-label-mono text-moss-400 mt-1 tracking-widest uppercase">{label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
