---
import { formatDate } from "./data";
import type { Article, PaginatedResource } from "./data";
import Icon from "../../components/ui/Icon.astro";

interface Props {
  articles: PaginatedResource<Article>;
}

const { articles } = Astro.props;
const rest = Array.isArray(articles?.data) ? articles.data.slice(1) : [];
const isEmpty = articles.meta.total === 0;
---

<section class="mx-auto max-w-6xl px-6 py-6 sm:px-8">
  <div id="grid-container" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      rest.map((article) => (
        <a
          href={`/article/${article.slug}`}
          class="group flex flex-col rounded-xl border border-ink/10 bg-canvas p-6 transition-colors hover:border-article/40 no-underline"
          data-category={article.category.name}
          data-title={article.title.toLowerCase()}
          aria-label={`Read article: ${article.title}`}
        >
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-full border border-ink/10 px-3 py-1 font-mono text-xs text-ink-soft transition-colors group-hover:border-article/40 group-hover:text-article-deep">
              {article.category.name}
            </span>
            <time class="font-mono text-xs text-ink-soft" datetime={article.createdAt}>
              {formatDate(article.createdAt)}
            </time>
          </div>

          <h3 class="mt-5 font-display text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-article-deep">
            {article.title}
          </h3>

          <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-ink-soft">
            {article.excerpt}
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            {article.tags.slice(0, 3).map((tag) => (
              <span class="font-mono text-xs text-ink-soft">#{tag.name}</span>
            ))}
          </div>

          <div class="mt-6 flex items-center justify-between border-t border-ink/10 pt-4">
            <span class="font-mono text-xs text-ink-soft">by {article.author}</span>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-article-deep">
              Read
              <Icon
                name="arrow-right"
                class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
              />
            </span>
          </div>
        </a>
      ))
    }
  </div>

  <div id="empty-state" class={`${isEmpty ? "block" : "hidden"} py-24 text-center`}>
    <div
      class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-article-tint"
    >
      <Icon name="search" class="h-6 w-6 text-article-deep" />
    </div>
    <h3 class="font-display text-2xl font-semibold text-ink">
      {isEmpty ? "No articles yet" : "No matches found"}
    </h3>
    <p class="mt-2 text-sm text-ink-soft">
      {
        isEmpty
          ? "New writing is on the way. Check back soon."
          : "Try a different search term or category."
      }
    </p>
  </div>
</section>
