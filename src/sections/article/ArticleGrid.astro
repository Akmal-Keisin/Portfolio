---
import { formatDate } from "./data";
import type { Article, PaginatedResource } from "./data";

interface Props {
  articles: PaginatedResource<Article>;
}

const { articles } = Astro.props;
const rest = Array.isArray(articles?.data) ? articles.data.slice(1) : [];
const isEmpty = articles.meta.total === 0;
---
<section class="mx-auto max-w-6xl px-6 py-6 sm:px-8">
  <div id="grid-container" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {rest.map((article, i) => (
      <a
        href={`/article/${article.slug}`}
        class="group flex flex-col rounded-3xl border border-ink/10 bg-base p-6 transition-all hover:-translate-y-1 hover:border-article/40 hover:shadow-lg no-underline"
        data-category={article.category.name}
        data-title={article.title.toLowerCase()}
        aria-label={`Read article: ${article.title}`}
      >
        <div class="flex flex-1 flex-col">
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-2 rounded-full border border-ink/10 px-3 py-1 font-mono text-xs text-ink transition-colors group-hover:border-article/40 group-hover:text-article-deep">
              {article.category.name}
            </span>
            <time class="font-mono text-xs text-ink-soft" datetime={article.createdAt}>
              {formatDate(article.createdAt)}
            </time>
          </div>

          <h3 class="mt-5 font-display text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-article-deep">
            {article.title}
          </h3>

          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft line-clamp-3">
            {article.excerpt}
          </p>

          <div class="mt-6 flex flex-wrap gap-1.5">
            {article.tags.slice(0, 3).map((tag) => (
              <span class="rounded-full border border-ink/10 px-2.5 py-0.5 font-mono text-xs text-ink-soft">
                #{tag.name}
              </span>
            ))}
          </div>

          <div class="mt-6 flex items-center justify-between border-t border-ink/10 pt-4">
            <span class="font-mono text-xs text-ink-soft">by {article.author}</span>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-article-deep">
              Read
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" class="transition-transform group-hover:translate-x-0.5">
                <path d="M2 7h10M8 3l4 4-4 4" />
              </svg>
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <!-- Empty state -->
  <div id="empty-state" class={`${isEmpty ? "block" : "hidden"} py-24 text-center`}>
    <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-article-tint">
      <svg class="h-7 w-7 text-article-deep" viewBox="0 0 80 120" fill="none" aria-hidden="true">
        <path d="M40 10C40 10 10 40 10 70C10 88 23 100 40 100C57 100 70 88 70 70C70 40 40 10 40 10Z" fill="currentColor" />
        <line x1="40" y1="100" x2="40" y2="115" stroke="currentColor" stroke-width="2" />
      </svg>
    </div>
    <h3 class="font-display text-2xl font-semibold text-ink">
      {isEmpty ? "Coming soon" : "No matches found"}
    </h3>
    <p class="mt-2 font-mono text-sm text-ink-soft">
      {isEmpty
        ? "I'm still drafting the first post. Check back soon."
        : "Adjust your search or filters to find what you're looking for."}
    </p>
  </div>
</section>