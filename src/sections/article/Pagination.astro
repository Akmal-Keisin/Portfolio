---
import type { Article, PaginatedResource } from "./data";
import Icon from "../../components/ui/Icon.astro";

interface Props {
  articles: PaginatedResource<Article>;
}

const { articles } = Astro.props;

const getPageLink = (url: string | null) => {
  if (!url) return undefined;
  try {
    const params = new URL(url).searchParams;
    const page = params.get("page");
    return page ? `/article?page=${page}` : "/article";
  } catch {
    return undefined;
  }
};
---

<section class="mx-auto max-w-6xl px-6 pb-24 sm:px-8">
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-ink/10 pt-8">
    <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">
      Page {articles.meta.current_page} of {articles.meta.last_page}, showing {articles.meta.from}-{articles
        .meta.to} of {articles.meta.total}
    </span>

    <div class="flex items-center gap-1.5">
      <a
        href={getPageLink(articles.links.prev)}
        class={`inline-flex h-10 w-10 items-center justify-center rounded-lg border transition-colors no-underline ${articles.links.prev ? "border-ink/10 bg-base text-ink hover:border-ink/25 hover:bg-surface" : "pointer-events-none cursor-not-allowed border-ink/5 text-ink-soft/40"}`}
        aria-disabled={articles.links.prev === null}
        aria-label="Previous page"
      >
        <Icon name="chevron-left" class="h-4 w-4" />
      </a>

      {
        Array.from({ length: articles.meta.last_page }, (_, i) => i + 1).map((p) => (
          <a
            href={`/article?page=${p}`}
            class={`inline-flex h-10 w-10 items-center justify-center rounded-lg border font-mono text-xs transition-colors no-underline ${p === articles.meta.current_page ? "border-ink bg-ink text-base" : "border-ink/10 bg-base text-ink-soft hover:border-ink/25 hover:text-ink"}`}
            aria-current={p === articles.meta.current_page ? "page" : undefined}
          >
            {p}
          </a>
        ))
      }

      <a
        href={getPageLink(articles.links.next)}
        class={`inline-flex h-10 w-10 items-center justify-center rounded-lg border transition-colors no-underline ${articles.links.next ? "border-ink/10 bg-base text-ink hover:border-ink/25 hover:bg-surface" : "pointer-events-none cursor-not-allowed border-ink/5 text-ink-soft/40"}`}
        aria-disabled={articles.links.next === null}
        aria-label="Next page"
      >
        <Icon name="chevron-right" class="h-4 w-4" />
      </a>
    </div>

    <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">
      {articles.meta.per_page} articles per page
    </span>
  </div>
</section>
