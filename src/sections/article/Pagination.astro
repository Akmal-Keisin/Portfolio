---
import type { Article, PaginatedResource } from "./data";
import Icon from "../../components/ui/Icon.astro";

interface Props {
  articles: PaginatedResource<Article>;
}

const { articles } = Astro.props;

function pageHref(page: number) {
  const url = new URL(Astro.url);
  if (page === 1) url.searchParams.delete("page");
  else url.searchParams.set("page", String(page));
  return url.pathname + url.search;
}
---

<section class="mx-auto max-w-6xl px-6 pb-24 sm:px-8">
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-ink/10 pt-8">
    <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">
      Page {articles.meta.current_page} of {articles.meta.last_page}, {articles.meta.total} total
    </span>

    <div class="flex flex-wrap items-center gap-1.5">
      <a
        href={articles.links.prev ? pageHref(articles.meta.current_page - 1) : undefined}
        class={`inline-flex h-10 w-10 items-center justify-center rounded-lg border transition-colors no-underline ${articles.links.prev ? "border-ink/10 bg-canvas text-ink hover:border-ink/25 hover:bg-surface" : "pointer-events-none cursor-not-allowed border-ink/5 text-ink-soft/40"}`}
        aria-disabled={articles.links.prev === null}
        aria-label="Previous page"
      >
        <Icon name="chevron-left" class="h-4 w-4" />
      </a>

      {
        Array.from({ length: articles.meta.last_page }, (_, i) => i + 1).map((p) => (
          <a
            href={pageHref(p)}
            class={`inline-flex h-10 w-10 items-center justify-center rounded-lg border font-mono text-xs transition-colors no-underline ${p === articles.meta.current_page ? "border-ink bg-ink text-canvas" : "border-ink/10 bg-canvas text-ink-soft hover:border-ink/25 hover:text-ink"}`}
            aria-current={p === articles.meta.current_page ? "page" : undefined}
          >
            {p}
          </a>
        ))
      }

      <a
        href={articles.links.next ? pageHref(articles.meta.current_page + 1) : undefined}
        class={`inline-flex h-10 w-10 items-center justify-center rounded-lg border transition-colors no-underline ${articles.links.next ? "border-ink/10 bg-canvas text-ink hover:border-ink/25 hover:bg-surface" : "pointer-events-none cursor-not-allowed border-ink/5 text-ink-soft/40"}`}
        aria-disabled={articles.links.next === null}
        aria-label="Next page"
      >
        <Icon name="chevron-right" class="h-4 w-4" />
      </a>
    </div>

    <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">
      {articles.meta.per_page} articles per page
    </span>
  </div>
</section>
