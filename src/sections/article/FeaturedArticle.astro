---
import { formatDate } from "./data";
import type { Article } from "./data";
import Icon from "../../components/ui/Icon.astro";

interface Props {
  featured: Article;
}

const { featured } = Astro.props;
---

{
  featured && (
    <section class="mx-auto max-w-6xl px-6 pb-16 sm:px-8" data-category={featured.category.name}>
      <a
        href={`/article/${featured.slug}`}
        class="group block rounded-2xl border border-article/30 bg-article-tint/40 p-8 transition-colors hover:border-article no-underline sm:p-12"
        aria-label={`Read featured article: ${featured.title}`}
      >
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-article-tint px-3 py-1 font-mono text-xs text-article-deep">
            <Icon name="star" class="h-3 w-3" />
            Featured
          </span>
          <span class="rounded-full border border-ink/10 bg-base px-3 py-1 font-mono text-xs text-ink-soft">
            {featured.category.name}
          </span>
          <time class="font-mono text-xs text-ink-soft" datetime={featured.createdAt}>
            {formatDate(featured.createdAt)}
          </time>
        </div>

        <h2 class="mt-6 max-w-3xl font-display text-3xl font-semibold leading-snug text-ink transition-colors group-hover:text-article-deep sm:text-4xl">
          {featured.title}
        </h2>

        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          {featured.excerpt}
        </p>

        <div class="mt-6 flex flex-wrap gap-1.5">
          {featured.tags.map((tag) => (
            <span class="rounded-full border border-ink/10 px-2.5 py-0.5 font-mono text-xs text-ink-soft">
              #{tag.name}
            </span>
          ))}
        </div>

        <div class="mt-8 flex items-center justify-between border-t border-ink/10 pt-6">
          <span class="font-mono text-xs text-ink-soft">by {featured.author}</span>
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-article-deep">
            Read article
            <Icon
              name="arrow-right"
              class="h-4 w-4 transition-transform group-hover:translate-x-1"
            />
          </span>
        </div>
      </a>
    </section>
  )
}
