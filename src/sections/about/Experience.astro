---
import SectionContainer from "../../components/layout/SectionContainer.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";
import TimelineItem from "../../components/cards/TimelineItem.astro";
import { experience } from "../../data/experience";
---

<SectionContainer id="experience" bg="base">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <SectionHeading
      title="Where I've worked"
      description="The roles and projects that shaped how I build software."
    />

    <div>
      {
        experience.map((item, index) => (
          <TimelineItem
            variant="exp"
            title={item.role}
            subtitle={item.company}
            period={item.period}
            location={item.location}
            summary={item.summary}
            tags={item.tags}
            isLast={index === experience.length - 1}
          />
        ))
      }
    </div>
  </div>
</SectionContainer>
