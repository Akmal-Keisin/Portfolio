---
import SectionContainer from "../../components/layout/SectionContainer.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";

const principles = [
  {
    title: "Accessibility first",
    desc: "Everyone deserves working software. I start from semantic HTML and WCAG standards so the result is usable by more people, not fewer.",
  },
  {
    title: "Understand the system",
    desc: "I learn the fundamentals before the framework. Knowing how the pieces work underneath makes for better architectural decisions.",
  },
  {
    title: "Keep learning",
    desc: "The stack moves fast. I stay current by reading, rebuilding, and testing ideas in real projects rather than at a distance.",
  },
  {
    title: "Ship, then improve",
    desc: "I favor getting code into production early and making it better from real usage and feedback, instead of perfecting it in a vacuum.",
  },
];
---

<SectionContainer id="principles" bg="surface">
  <SectionHeading
    title="How I work"
    description="Four guidelines I use to keep projects robust, inclusive, and maintainable."
  />

  <div class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
    {
      principles.map((p) => (
        <div class="border-t border-ink/15 pt-6">
          <h3 class="font-display text-lg font-semibold text-ink">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{p.desc}</p>
        </div>
      ))
    }
  </div>
</SectionContainer>
