---
import Badge from "../../components/ui/Badge.astro";

const stack = ["PHP", "Laravel", "MySQL", "PostgreSQL", "TypeScript", "Vue", "Go", "Astro"];
---

<section id="about" class="scroll-mt-20 border-b border-ink/10 bg-canvas">
  <div class="mx-auto max-w-6xl px-6 pb-16 pt-16 sm:px-8 sm:pb-20 sm:pt-20">
    <p class="font-mono text-sm uppercase tracking-[0.3em] text-ink-soft">My story</p>

    <h1
      class="mt-4 max-w-3xl font-display text-5xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-6xl"
    >
      Four years building software that has to work
    </h1>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <p class="text-lg leading-relaxed text-ink">
        I'm <strong class="font-semibold">Akmal Keisin</strong>, a full-stack developer based in
        Semarang. I started building websites at 18 and have been shipping to production ever since.
      </p>
      <p class="text-base leading-relaxed text-ink-soft">
        The modern stack shifts constantly. I learn the fundamentals first, then the tools, so the
        architecture still holds up when the framework changes.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-2">
      {stack.map((item) => <Badge variant="neutral">{item}</Badge>)}
    </div>
  </div>
</section>
