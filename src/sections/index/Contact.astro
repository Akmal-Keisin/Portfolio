---
---

<section id="contact" class="py-28 bg-sage-100/30 relative overflow-hidden">
  <!-- Background leaf -->
  <div class="absolute -bottom-20 -right-20 w-80 h-80 opacity-[.03] pointer-events-none">
    <svg width="100%" height="100%" viewBox="0 0 80 120" fill="none">
      <path d="M40 10C40 10 10 40 10 70C10 88 23 100 40 100C57 100 70 88 70 70C70 40 40 10 40 10Z" fill="#3e7d32"/>
    </svg>
  </div>

  <div class="relative max-w-6xl mx-auto px-6">
    <div class="reveal mb-16 text-center">
      <span class="accent-line mx-auto mb-4"></span>
      <p class="text-label-mono text-moss-400 mt-4">Get In Touch</p>
      <h2 class="text-section-title text-ink mt-2">
        Let's start a<br /><em class="text-moss-500">conversation</em>
      </h2>
      <p class="text-section-desc text-moss-600 max-w-lg mx-auto mt-6">
        Currently open to new projects and interesting collaborations. Feel free
        to reach out if you have something in mind.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Contact info -->
      <div class="reveal d1 space-y-8">
        <div class="bg-white/60 border border-moss-100 rounded-3xl p-8 shadow-sm">
          <h3 class="text-card-title text-ink mb-6">Contact Details</h3>
          <div class="space-y-6">
            <a href="mailto:hello@akmalkeisin.com" class="flex items-center gap-4 group no-underline">
              <div class="w-12 h-12 rounded-2xl bg-mint/30 flex items-center justify-center text-moss-600 group-hover:bg-moss-500 group-hover:text-fog transition-all">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div>
                <div class="text-label-mono text-moss-400">Email</div>
                <div class="font-body text-base font-semibold text-ink group-hover:text-moss-600 transition-colors">
                  hello@akmalkeisin.com
                </div>
              </div>
            </a>
            <div class="flex items-center gap-4 group">
              <div class="w-12 h-12 rounded-2xl bg-mint/30 flex items-center justify-center text-moss-600">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div>
                <div class="text-label-mono text-moss-400">Location</div>
                <div class="font-body text-base font-semibold text-ink">
                  Semarang, Indonesia
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Socials -->
        <div class="flex items-center gap-4 px-2">
          <span class="text-label-mono text-moss-400">Find me on</span>
          <div class="flex gap-3">
            {
              [
                ["Github", "#"],
                ["Linkedin", "#"],
                ["Twitter", "#"],
              ].map(([l, h]) => (
                <a href={h} class="text-label-mono text-moss-600 hover:text-moss-900 transition-colors bg-white/40 border border-moss-100 px-4 py-2 rounded-full no-underline">
                  {l}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Mini form -->
      <div class="reveal d2">
        <form class="bg-white border border-moss-100 rounded-3xl p-8 shadow-sm space-y-5">
          <div class="space-y-2">
            <label for="f-name" class="text-label-mono text-moss-400 ml-1">Name</label>
            <input type="text" id="f-name" class="w-full bg-fog/50 border border-moss-100 rounded-xl px-4 py-3 font-body text-sm focus:outline-none focus:border-moss-500 transition-colors" placeholder="Your name" />
          </div>
          <div class="space-y-2">
            <label for="f-email" class="text-label-mono text-moss-400 ml-1">Email</label>
            <input type="email" id="f-email" class="w-full bg-fog/50 border border-moss-100 rounded-xl px-4 py-3 font-body text-sm focus:outline-none focus:border-moss-500 transition-colors" placeholder="your@email.com" />
          </div>
          <div class="space-y-2">
            <label for="f-msg" class="text-label-mono text-moss-400 ml-1">Message</label>
            <textarea id="f-msg" rows="4" class="w-full bg-fog/50 border border-moss-100 rounded-xl px-4 py-3 font-body text-sm focus:outline-none focus:border-moss-500 transition-colors resize-none" placeholder="How can I help?"></textarea>
          </div>
          <button type="submit" class="w-full bg-moss-700 text-fog font-semibold py-4 rounded-xl hover:bg-ink transition-all shadow-md hover:shadow-lg">
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
