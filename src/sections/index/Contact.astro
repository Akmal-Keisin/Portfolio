---
import { profile } from "../../data/profile";
import SocialIcon from "../../components/ui/SocialIcon.astro";
---

<section id="contact" class="py-28 bg-surface relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -left-24 -top-24 h-96 w-96 rounded-full bg-exp-tint blur-3xl"></div>
    <div class="absolute right-[-6rem] top-10 h-80 w-80 rounded-full bg-folio-tint blur-3xl"></div>
    <div class="absolute bottom-[-8rem] left-1/3 h-96 w-96 rounded-full bg-article-tint blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-6 sm:px-8">
    <div class="mb-16 text-center">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-medium uppercase tracking-[0.2em] text-ink-soft">
        <span class="h-2 w-2 rounded-full bg-exp" aria-hidden="true"></span>
        Get In Touch
      </div>
      <h2 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">
        Let's start a <em class="italic text-exp-deep">conversation</em>
      </h2>
      <p class="mt-4 max-w-lg text-base text-ink-soft mx-auto">
        Currently open to new projects and interesting collaborations. Feel free
        to reach out if you have something in mind.
      </p>
    </div>

    <div class="grid gap-12 lg:grid-cols-2 items-start">
      <!-- Contact info -->
      <div class="space-y-6">
        <div class="rounded-3xl border border-ink/10 bg-base p-8 shadow-sm">
          <h3 class="font-display text-xl font-semibold text-ink mb-6">Contact Details</h3>
          <div class="space-y-6">
            <a href={`mailto:${profile.email}`} class="flex items-center gap-4 group no-underline">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-exp-tint text-exp-deep transition-colors group-hover:bg-exp group-hover:text-base">
                <SocialIcon icon="mail" class="h-5 w-5" />
              </div>
              <div>
                <div class="font-mono text-xs uppercase tracking-widest text-ink-soft">Email</div>
                <div class="text-sm font-semibold text-ink group-hover:text-exp-deep transition-colors">
                  {profile.email}
                </div>
              </div>
            </a>
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-surface text-ink-soft">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div>
                <div class="font-mono text-xs uppercase tracking-widest text-ink-soft">Location</div>
                <div class="text-sm font-semibold text-ink">{profile.location}</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Socials -->
        <div class="flex items-center gap-4 px-2">
          <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">Find me on</span>
          <div class="flex gap-2">
            {profile.socials.filter((s) => s.label !== "Email").map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-9 w-9 items-center justify-center rounded-full border border-ink/10 bg-base text-ink-soft transition-colors hover:border-exp/40 hover:text-exp-deep"
                aria-label={social.label}
              >
                <SocialIcon icon={social.icon as any} class="h-4 w-4" />
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Contact form -->
      <div>
        <div id="index-form-feedback" class="mb-6 hidden rounded-2xl p-4 text-sm"></div>

        <form id="index-contact-form" class="rounded-3xl border border-ink/10 bg-base p-8 shadow-sm space-y-5">
          <div class="space-y-2">
            <label for="f-name" class="block text-sm font-medium text-ink">Name *</label>
            <input type="text" id="f-name" name="name" required placeholder="Your name" class="w-full rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep focus:outline-none transition-colors" />
          </div>
          <div class="space-y-2">
            <label for="f-email" class="block text-sm font-medium text-ink">Email *</label>
            <input type="email" id="f-email" name="email" required placeholder="your@email.com" class="w-full rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep focus:outline-none transition-colors" />
          </div>
          <div class="space-y-2">
            <label for="f-subject" class="block text-sm font-medium text-ink">Subject *</label>
            <input type="text" id="f-subject" name="subject" required placeholder="Project Inquiry" class="w-full rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep focus:outline-none transition-colors" />
          </div>
          <div class="space-y-2">
            <label for="f-msg" class="block text-sm font-medium text-ink">Message *</label>
            <textarea id="f-msg" name="message" rows="4" required placeholder="How can I help?" class="w-full resize-none rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep focus:outline-none transition-colors"></textarea>
          </div>
          <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-exp-deep px-6 py-3 text-sm font-semibold text-base shadow-[0_4px_0_0_var(--color-ink)] transition-all duration-200 hover:translate-y-[2px] hover:bg-exp hover:shadow-[0_2px_0_0_var(--color-ink)] disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none disabled:hover:translate-y-0 disabled:hover:bg-exp-deep disabled:hover:shadow-none">
            <span class="submit-text">Send Message</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { sendMessage } from "@lib/api";

  const form = document.getElementById("index-contact-form") as HTMLFormElement;
  const feedback = document.getElementById("index-form-feedback") as HTMLDivElement;
  const submitBtn = form?.querySelector("button[type='submit']") as HTMLButtonElement;
  const submitText = form?.querySelector(".submit-text") as HTMLSpanElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!form || !feedback || !submitBtn || !submitText) return;

    feedback.classList.add("hidden");
    feedback.classList.remove("bg-exp-tint", "text-exp-deep", "bg-article-tint", "text-article-deep");

    submitBtn.disabled = true;
    submitText.textContent = "Sending...";

    const formData = new FormData(form);
    const data = {
      name: formData.get("name") as string,
      email: formData.get("email") as string,
      subject: formData.get("subject") as string,
      message: formData.get("message") as string,
    };

    try {
      const result = await sendMessage(data);

      feedback.textContent = result.message;
      feedback.classList.add("bg-exp-tint", "text-exp-deep");
      feedback.classList.remove("hidden");
      form.reset();
    } catch (error) {
      feedback.textContent = error instanceof Error ? error.message : "Something went wrong. Please try again.";
      feedback.classList.add("bg-article-tint", "text-article-deep");
      feedback.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = "Send Message";
    }
  });
</script>
