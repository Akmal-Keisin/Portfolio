---
import { profile } from "@data/profile";
import SectionContainer from "@components/layout/SectionContainer.astro";
import SectionHeading from "@components/layout/SectionHeading.astro";
import SocialIcon from "@components/ui/SocialIcon.astro";
import Icon from "@components/ui/Icon.astro";
---

<SectionContainer id="contact" bg="surface">
  <SectionHeading
    align="center"
    title="Get in touch"
    description="Open to new projects and collaborations. Tell me what you are working on and I will reply within a day or two."
  />

  <div class="mt-14 grid items-start gap-10 lg:grid-cols-2">
    <div class="space-y-6">
      <div class="rounded-2xl border border-ink/10 bg-base p-8">
        <h3 class="font-display text-lg font-semibold text-ink">Contact details</h3>
        <div class="mt-6 space-y-5">
          <a href={`mailto:${profile.email}`} class="group flex items-center gap-4">
            <span
              class="flex h-11 w-11 items-center justify-center rounded-full bg-exp-tint text-exp-deep"
            >
              <SocialIcon icon="mail" class="h-5 w-5" />
            </span>
            <span>
              <span class="block font-mono text-xs uppercase tracking-[0.18em] text-ink-soft">
                Email
              </span>
              <span class="text-sm font-medium text-ink transition-colors group-hover:text-accent">
                {profile.email}
              </span>
            </span>
          </a>
          <div class="flex items-center gap-4">
            <span
              class="flex h-11 w-11 items-center justify-center rounded-full bg-surface text-ink-soft"
            >
              <Icon name="map-pin" class="h-5 w-5" />
            </span>
            <span>
              <span class="block font-mono text-xs uppercase tracking-[0.18em] text-ink-soft">
                Location
              </span>
              <span class="text-sm font-medium text-ink">{profile.location}</span>
            </span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-4 px-1">
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-ink-soft">
          Find me on
        </span>
        <div class="flex gap-2">
          {
            profile.socials
              .filter((social) => social.label !== "Email")
              .map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-ink/10 bg-base text-ink-soft transition-colors hover:border-accent/40 hover:text-accent"
                >
                  <SocialIcon icon={social.icon as any} class="h-4 w-4" />
                </a>
              ))
          }
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-ink/10 bg-base p-6 sm:p-8">
      <h3 class="font-display text-xl font-semibold text-ink">Tell me about your project</h3>
      <p class="mt-2 text-sm text-ink-soft">
        I read every message myself.
      </p>

      <div id="index-form-feedback" class="mt-6 hidden rounded-lg p-4 text-sm"></div>

      <form id="index-contact-form" class="mt-6 space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="f-name" class="mb-1.5 block text-sm font-medium text-ink">
              Your name *
            </label>
            <input
              type="text"
              id="f-name"
              name="name"
              required
              placeholder="Your full name"
              class="w-full rounded-lg border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft focus:border-accent"
            />
          </div>
          <div>
            <label for="f-email" class="mb-1.5 block text-sm font-medium text-ink">
              Email address *
            </label>
            <input
              type="email"
              id="f-email"
              name="email"
              required
              placeholder="you@example.com"
              class="w-full rounded-lg border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft focus:border-accent"
            />
          </div>
        </div>

        <div>
          <label for="f-subject" class="mb-1.5 block text-sm font-medium text-ink">
            Subject *
          </label>
          <input
            type="text"
            id="f-subject"
            name="subject"
            required
            placeholder="Project inquiry"
            class="w-full rounded-lg border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft focus:border-accent"
          />
        </div>

        <div>
          <label for="f-msg" class="mb-1.5 block text-sm font-medium text-ink">
            Message *
          </label>
          <textarea
            id="f-msg"
            name="message"
            rows="6"
            required
            placeholder="What are you building, and what do you need from me?"
            class="w-full resize-none rounded-lg border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft focus:border-accent"
          ></textarea>
        </div>

        <div aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none;">
          <label for="f-website">Leave this empty</label>
          <input type="text" id="f-website" name="website" tabindex="-1" autocomplete="off" value="" />
        </div>

        <button
          type="submit"
          class="inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-full bg-accent px-6 py-3 text-sm font-semibold text-base shadow-[0_3px_0_0_var(--color-ink)] transition-all duration-200 hover:translate-y-[2px] hover:bg-accent-hover hover:shadow-[0_1px_0_0_var(--color-ink)] disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none disabled:hover:translate-y-0"
        >
          <span class="submit-text">Send message</span>
          <Icon name="send" class="h-4 w-4" />
        </button>
      </form>
    </div>
  </div>
</SectionContainer>

<script>
  import { sendMessage } from "@lib/api";

  const form = document.getElementById("index-contact-form") as HTMLFormElement;
  const feedback = document.getElementById("index-form-feedback") as HTMLDivElement;
  const submitBtn = form?.querySelector("button[type='submit']") as HTMLButtonElement;
  const submitText = form?.querySelector(".submit-text") as HTMLSpanElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!form || !feedback || !submitBtn || !submitText) return;

    feedback.classList.add("hidden");
    feedback.classList.remove("bg-exp-tint", "text-exp-deep", "bg-article-tint", "text-article-deep");

    submitBtn.disabled = true;
    submitText.textContent = "Sending...";

    const formData = new FormData(form);
    const data = {
      name: formData.get("name") as string,
      email: formData.get("email") as string,
      subject: formData.get("subject") as string,
      message: formData.get("message") as string,
      website: formData.get("website") as string,
    };

    try {
      const result = await sendMessage(data);

      feedback.textContent = result.message;
      feedback.classList.add("bg-exp-tint", "text-exp-deep");
      feedback.classList.remove("hidden");
      form.reset();
    } catch (error) {
      feedback.textContent =
        error instanceof Error ? error.message : "Something went wrong. Please try again.";
      feedback.classList.add("bg-article-tint", "text-article-deep");
      feedback.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = "Send message";
    }
  });
</script>
