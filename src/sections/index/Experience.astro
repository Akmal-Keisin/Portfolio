---
import { experience } from "@data/experience";
import SectionContainer from "@components/layout/SectionContainer.astro";
import SectionHeading from "@components/layout/SectionHeading.astro";
import TimelineItem from "@components/cards/TimelineItem.astro";
---

<SectionContainer id="experience" bg="surface">
  <div class="grid gap-12 lg:grid-cols-[1fr_2fr] lg:items-start">
    <SectionHeading
      title="Experience"
      description="Four years of in-house product work, from intern to owning features end to end."
    />

    <div class="lg:pl-4">
      {
        experience.map((entry, index) => (
          <TimelineItem
            variant="exp"
            title={entry.role}
            subtitle={entry.company}
            period={entry.period}
            location={entry.location}
            summary={entry.summary}
            tags={entry.tags}
            isLast={index === experience.length - 1}
          />
        ))
      }
    </div>
  </div>
</SectionContainer>
