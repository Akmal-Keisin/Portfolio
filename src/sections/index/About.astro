---
---

<section id="about" class="py-28 bg-mint/50 relative overflow-hidden">

  <!-- Watermark -->
  <div class="absolute top-8 right-8 font-display text-[200px] leading-none text-moss-100 select-none pointer-events-none opacity-60">
    02
  </div>

  <div class="relative max-w-6xl mx-auto px-6">

    <!-- ── Row 1: Label + Heading + Bio side by side ── -->
    <div class="reveal mb-14 grid lg:grid-cols-[1fr_1fr] gap-12 items-start">
      <div>
        <span class="accent-line mb-4"></span>
        <span class="text-label-mono text-moss-400 block mt-4">About Me</span>
        <h2 class="text-section-title text-ink mt-3">
          More than<br /><em class="text-moss-500">just a learner</em>
        </h2>
      </div>

      <!-- Bio paragraphs sit beside the heading on large screens -->
      <div class="space-y-4">
        <p class="reveal d1 text-hero-subtitle text-moss-800/80">
          I'm <strong class="text-ink font-semibold">Akmal Keisin</strong>, a full-stack developer with three years of
          experience turning complex problems into elegant, maintainable software. I started
          building websites at 18 and never stopped.
        </p>
        <p class="reveal d2 text-section-desc text-moss-600">
          The modern tech stack shifts constantly. Mastering it requires an autodidactic
          mindset — driven by continuous learning and highly disciplined study. We are
          engineers, not magicians: true expertise means understanding how the underlying
          systems work.
        </p>
      </div>
    </div>

    <!-- ── Row 2: Principles + Education side by side ── -->
    <div class="grid lg:grid-cols-[1fr_300px] gap-6 mb-10">

      <!-- Principles -->
      <div class="reveal d2 grid grid-cols-2 gap-4 bg-white/60 border border-moss-100 rounded-2xl p-6 shadow-sm">
        {[
          ["Accessibility First", "Everyone deserves great software"],
          ["Deep Understanding",  "Fundamentals before frameworks"],
          ["Continuous Learning", "The stack evolves, so do I"],
          ["Ship Iteratively",    "Done › perfect, then improve"],
        ].map(([t, d]) => (
          <div class="flex gap-3 items-start">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="mt-0.5 shrink-0">
              <path d="M9 2C9 2 3 5 3 10C3 13 5.7 15.5 9 15.5C12.3 15.5 15 13 15 10C15 5 9 2 9 2Z" fill="#c8f0d0"/>
              <path d="M6 9.5L8 11.5L12 7.5" stroke="#2e5f25" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div>
              <div class="font-body text-sm font-semibold text-moss-800">{t}</div>
              <div class="font-body text-xs text-moss-500 mt-0.5 leading-snug">{d}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- Education — compact card, same height -->
      <div class="reveal d3 bg-white/60 border border-moss-200/60 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h3 class="font-display text-base font-semibold text-moss-700 mb-5">Education</h3>
          <div class="font-mono text-[10px] text-moss-400 tracking-wider">2019 – 2022</div>
          <div class="font-body text-sm font-semibold text-ink mt-0.5">Multimedia</div>
          <div class="font-body text-xs text-moss-500">SMKN 11 Semarang</div>
        </div>
        <div class="flex flex-wrap gap-2 mt-5">
          {["Design", "Photography", "Web Development", "Web Design"].map((t) => (
            <span class="font-mono text-[10px] text-moss-600 bg-white/70 border border-moss-200 px-2.5 py-1 rounded-full">
              {t}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- ── Row 3: Experience timeline — full width, horizontal scroll of cards ── -->
    <div class="reveal d3">
      <div class="flex items-center gap-3 mb-6">
        <h3 class="font-display text-base font-semibold text-moss-700">Work History</h3>
        <div class="flex-1 h-px bg-moss-100"></div>
        <span class="font-mono text-[10px] text-moss-400 tracking-widest uppercase">4 roles</span>
      </div>

      <!-- Horizontal card rail — scrollable on mobile, 4-col grid on desktop -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          {
            period: "Jun 2024 – Now",
            role: "Web Developer",
            org: "Reprime ID",
            stacks: ["PHP", "Laravel", "MySQL", "PostgreSQL", "TypeScript", "Vue", "Go", "Fiber", "Astro"],
            note: "Returned with more experience. Focus on developing the new version of the core product.",
            current: true,
          },
          {
            period: "Oct 2023 – Jun 2024",
            role: "Web Developer",
            org: "Crocodic",
            stacks: ["PHP", "Laravel", "MySQL", "TypeScript"],
            note: "Complex HR project for a large factory client with thousands of active users.",
            current: false,
          },
          {
            period: "Sep 2022 – Sep 2023",
            role: "Web Developer",
            org: "Reprime ID",
            stacks: ["PHP", "Laravel", "Lumen", "PostgreSQL", "MySQL"],
            note: "Full developer role after internship. New features, maintenance, and bug fixing.",
            current: false,
          },
          {
            period: "Jun 2022 – Aug 2022",
            role: "Intern",
            org: "Reprime ID",
            stacks: ["PHP", "Laravel", "MySQL"],
            note: "Helped maintain the product and ship small feature updates alongside a senior partner.",
            current: false,
          },
        ].map((item) => (
          <div class={`relative flex flex-col justify-between gap-4 rounded-2xl p-5 border shadow-sm transition-colors
            ${item.current
              ? "bg-moss-800 border-moss-600"
              : "bg-white/60 border-moss-100 hover:border-moss-300"
            }`}>

            <!-- Current badge -->
            {item.current && (
              <div class="absolute top-4 right-4 flex items-center gap-1.5">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-mint"></span>
                </span>
                <span class="font-mono text-[9px] text-mint tracking-widest uppercase">Now</span>
              </div>
            )}

            <div>
              <!-- Period -->
              <div class={`font-mono text-[10px] tracking-wider mb-2 ${item.current ? "text-moss-300" : "text-moss-400"}`}>
                {item.period}
              </div>

              <!-- Role + org -->
              <div class={`font-body text-sm font-semibold leading-tight ${item.current ? "text-fog" : "text-ink"}`}>
                {item.role}
              </div>
              <div class={`font-body text-xs mt-0.5 ${item.current ? "text-moss-300" : "text-moss-500"}`}>
                {item.org}
              </div>

              <!-- Note -->
              <p class={`font-body text-xs mt-3 leading-relaxed ${item.current ? "text-moss-300" : "text-moss-500"}`}>
                {item.note}
              </p>
            </div>

            <!-- Stack chips -->
            <div class="flex flex-wrap gap-1.5">
              {item.stacks.map((s) => (
                <span class={`font-mono text-[10px] px-2 py-0.5 rounded-full border
                  ${item.current
                    ? "text-mint border-moss-500 bg-moss-700/60"
                    : "text-moss-600 border-moss-200 bg-white/70"
                  }`}>
                  {s}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>