---
import Laravel from "@assets/logos/laravel-logo.svg";
import Vue from "@assets/logos/vue-js-logo.svg";
import Go from "@assets/logos/go-logo.svg";
import PostgreSQL from "@assets/logos/postgresql-logo.svg";
import AstroLogo from "@assets/logos/astro-logo-light-gradient.svg";
import PHP from "@assets/logos/php-logo.svg";
import { Image } from "astro:assets";
import Icon from "@components/ui/Icon.astro";

const tools = [
  { name: "Laravel", logo: Laravel }, { name: "Vue.js", logo: Vue },
  { name: "Go", logo: Go }, { name: "PostgreSQL", logo: PostgreSQL },
  { name: "Astro", logo: AstroLogo }, { name: "PHP", logo: PHP },
];
---

<section id="skills" aria-label="Technology stack" class="border-b border-ink/15 bg-surface">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-8 gap-y-4 px-6 py-5 sm:px-8 lg:justify-between">
    <a href="/skills" class="inline-flex min-h-11 items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-ink-soft hover:text-accent">My stack <Icon name="arrow-up-right" class="size-3.5" /></a>
    <ul class="flex flex-1 flex-wrap items-center gap-x-6 gap-y-4 sm:justify-between lg:border-l lg:border-ink/15 lg:pl-10">
      {tools.map((tool) => <li class="flex items-center gap-2 text-sm font-semibold tracking-tight text-ink-soft"><Image src={tool.logo} alt="" class:list={["size-6 object-contain", tool.name === "Astro" && "rounded-sm bg-[#252c23] p-0.5"]} />{tool.name}</li>)}
    </ul>
  </div>
</section>
