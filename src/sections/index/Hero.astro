---
import { profile } from "@data/profile";
import Button from "@components/ui/Button.astro";

const sections = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#skills", label: "Skills" },
  { href: "#portfolio", label: "Projects" },
  { href: "#article", label: "Articles" },
];
---

<section id="top" class="border-b border-ink/10 bg-base">
  <div class="mx-auto max-w-6xl px-6 pb-16 pt-16 sm:px-8 sm:pb-20 sm:pt-20">
    <p class="inline-flex items-center gap-2.5 font-mono text-xs text-ink-soft">
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      {profile.availability}
    </p>

    <h1
      class="mt-8 max-w-4xl font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl lg:text-7xl"
    >
      {profile.name}
    </h1>

    <p class="mt-6 max-w-2xl font-display text-2xl leading-snug tracking-tight text-ink-soft sm:text-3xl">
      Full-stack developer building and maintaining web software, from database
      design to the interface.
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="#portfolio">View my work</Button>
      <Button href="/contact" variant="secondary">Get in touch</Button>
    </div>

    <nav
      class="mt-14 flex flex-wrap items-center gap-x-7 gap-y-2 border-t border-ink/10 pt-6 font-mono text-sm"
      aria-label="Page sections"
    >
      {
        sections.map((section) => (
          <a
            href={section.href}
            class="text-ink-soft transition-colors hover:text-ink"
          >
            {section.label}
          </a>
        ))
      }
    </nav>
  </div>
</section>
