---
import { profile } from "@data/profile";
import Button from "@components/ui/Button.astro";
import Icon from "@components/ui/Icon.astro";
import StackExplorer from "./StackExplorer.astro";
const [givenName, ...familyName] = profile.name.split(" ");
---

<section id="top" aria-labelledby="intro-name" class="intro border-b border-ink/15">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-12 sm:px-8 sm:py-16 md:grid-cols-[1fr_1fr] lg:gap-16 lg:py-20">
    <div>
      <p class="flex items-center gap-3 font-mono text-xs font-medium uppercase tracking-[.14em] text-accent">
        <span class="h-px w-8 bg-current" aria-hidden="true"></span>{profile.role}
      </p>
      <h1 id="intro-name" class="mt-5 font-display text-[clamp(4.5rem,8.8vw,7.5rem)] font-semibold leading-[.87] tracking-[-.06em]">
        {givenName}<br />{familyName.join(" ")}<span class="text-accent">.</span>
      </h1>
      <p class="mt-6 max-w-[34ch] text-[1.1rem] leading-relaxed text-ink-soft sm:text-xl">
        {profile.tagline}
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <Button href="#portfolio" class="max-sm:px-3.5">Explore my work <Icon name="arrow-right" class="size-4" /></Button>
        <Button href="/contact" variant="secondary" class="max-sm:px-3.5">Get in touch <Icon name="arrow-up-right" class="size-4" /></Button>
      </div>
      <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[.69rem] text-ink-soft">
        <span class="inline-flex items-center gap-1.5"><Icon name="map-pin" class="size-3.5" />{profile.location}</span>
        <span class="inline-flex items-center gap-2"><span class="size-1.5 rounded-full bg-exp ring-4 ring-exp/10" aria-hidden="true"></span>{profile.availability}</span>
      </div>
    </div>
    <StackExplorer />
  </div>
</section>

<style>
  .intro { background-image: radial-gradient(ellipse at 82% 52%, color-mix(in srgb,var(--color-exp) 7%,transparent), transparent 55%); }
</style>
