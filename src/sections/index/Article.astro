---
import { getArticles } from "@lib/api";
import type { Article } from "@sections/article/data";
import { formatDate } from "@sections/article/data";
import SectionContainer from "@components/layout/SectionContainer.astro";
import SectionHeading from "@components/layout/SectionHeading.astro";
import Button from "@components/ui/Button.astro";

let articles: Article[] = [];
try {
  const res = await getArticles(1);
  articles = res?.data ?? [];
} catch (error) {
  console.error("Failed to fetch articles:", error);
}

const latest = articles.slice(0, 4);
---

<SectionContainer id="article" bg="base">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <SectionHeading
      title="Writing"
      description="Notes on the tools and problems I run into while building."
    />
    <Button href="/article" variant="ghost">All articles</Button>
  </div>

  {
    latest.length > 0 ? (
      <ul class="mt-10 max-w-3xl divide-y divide-ink/10 border-y border-ink/10">
        {latest.map((article) => (
          <li>
            <a
              href={`/article/${article.slug}`}
              class="group grid gap-2 py-6 sm:grid-cols-[7rem_1fr] sm:items-baseline sm:gap-6"
            >
              <span class="font-mono text-xs text-ink-soft">
                {formatDate(article.createdAt)}
              </span>
              <div>
                <h3 class="font-display text-lg font-semibold text-ink transition-colors group-hover:text-article-deep">
                  {article.title}
                </h3>
                <p class="mt-2 line-clamp-2 max-w-prose text-sm leading-relaxed text-ink-soft">
                  {article.excerpt}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-10 max-w-3xl rounded-2xl border border-dashed border-ink/15 bg-surface p-10 text-sm leading-relaxed text-ink-soft">
        Nothing is published yet. New notes will appear here first.
      </p>
    )
  }
</SectionContainer>
