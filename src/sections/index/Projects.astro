---
import { getProjects } from "@lib/api";
import type { Project } from "@lib/api";
import SectionContainer from "@components/layout/SectionContainer.astro";
import SectionHeading from "@components/layout/SectionHeading.astro";
import PortfolioCard from "@components/cards/PortfolioCard.astro";
import Button from "@components/ui/Button.astro";

let projects: Project[] = [];
try {
  const res = await getProjects(1);
  projects = res?.data ?? [];
} catch (error) {
  console.error("Failed to fetch projects:", error);
}
---

<SectionContainer id="portfolio" bg="surface">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <SectionHeading
      title="Projects"
      description="A few things I have designed, built, and kept running."
    />
    <Button href="/project" variant="ghost">All projects</Button>
  </div>

  {
    projects.length > 0 ? (
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.slice(0, 3).map((project) => <PortfolioCard project={project} />)}
      </div>
    ) : (
      <p class="mt-12 max-w-2xl rounded-2xl border border-dashed border-ink/15 bg-canvas p-10 text-sm leading-relaxed text-ink-soft">
        No projects are published yet. They will appear here as soon as they are
        ready.
      </p>
    )
  }
</SectionContainer>
