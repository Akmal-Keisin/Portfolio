---
import SectionContainer from "../../components/layout/SectionContainer.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";

const secondarySkills = [
  "Git & GitHub",
  "Docker",
  "Redis",
  "REST APIs",
  "TypeScript",
  "Tailwind CSS",
  "Unit Testing",
  "CI/CD",
  "Linux",
  "Nginx",
];
---

<SectionContainer bg="surface">
  <SectionHeading
    eyebrow="Complementary"
    title="Tools I pair with the core stack"
    description="Beyond the core stack, I use a variety of tools and methodologies to ensure robust, modern deployment and collaboration."
    accent="exp"
    align="center"
  />

  <div class="mt-12 flex flex-wrap justify-center gap-3">
    {secondarySkills.map((skill) => (
      <span class="cursor-default rounded-full border border-ink/10 bg-base px-5 py-2.5 font-mono text-sm text-ink-soft transition-colors hover:border-exp/50 hover:text-exp-deep">
        {skill}
      </span>
    ))}
  </div>
</SectionContainer>