---
import SectionContainer from "../../components/layout/SectionContainer.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";

const secondarySkills = [
  "Git & GitHub",
  "Docker",
  "Redis",
  "REST APIs",
  "TypeScript",
  "Tailwind CSS",
  "Unit Testing",
  "CI/CD",
  "Linux",
  "Nginx",
];
---

<SectionContainer bg="surface">
  <SectionHeading
    title="Tools I pair with the core stack"
    description="The supporting tools and practices I use to deploy and maintain software."
  />

  <ul class="mt-12 flex flex-wrap gap-2.5">
    {
      secondarySkills.map((skill) => (
        <li class="rounded-full border border-ink/15 px-4 py-2 font-mono text-sm text-ink-soft">
          {skill}
        </li>
      ))
    }
  </ul>
</SectionContainer>
