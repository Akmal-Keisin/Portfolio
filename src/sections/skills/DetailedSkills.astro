---
import AstroLogo from "@assets/logos/astro-logo-light-gradient.svg";
import PHPLogo from "@assets/logos/php-logo.svg";
import GoLogo from "@assets/logos/go-logo.svg";
import GoFiberLogo from "@assets/logos/go-fiber-logo.svg";
import JavascriptLogo from "@assets/logos/javascript-logo.svg";
import VueJSLogo from "@assets/logos/vue-js-logo.svg";
import LaravelLogo from "@assets/logos/laravel-logo.svg";
import PostgreSQLLogo from "@assets/logos/postgresql-logo.svg";
import MySQLLogo from "@assets/logos/mysql-logo.svg";
import { Image } from "astro:assets";
import SectionContainer from "../../components/layout/SectionContainer.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";

const detailedSkills = [
  {
    category: "Languages",
    description: "The core foundations of my technical stack. I prioritize type safety, performance, and clean syntax.",
    items: [
      { name: "PHP", logo: PHPLogo, level: "Advanced", years: "4+ years", detail: "Expertise in modern PHP (8.x+), focusing on performance and robust backend systems." },
      { name: "Go", logo: GoLogo, level: "Advanced", years: "2+ years", detail: "Building high-concurrency microservices and fast API gateways with Go." },
      { name: "JavaScript", logo: JavascriptLogo, level: "Advanced", years: "4+ years", detail: "Proficient in modern ES6+, TypeScript, and building interactive frontend experiences." },
    ],
  },
  {
    category: "Frameworks",
    description: "Tools that help me build scalable applications faster without compromising on quality.",
    items: [
      { name: "Laravel", logo: LaravelLogo, level: "Expert", years: "4+ years", detail: "Deep understanding of the Laravel ecosystem, including Eloquent, Queues, and Service Containers." },
      { name: "Go Fiber", logo: GoFiberLogo, level: "Advanced", years: "2+ years", detail: "Building lightweight, high-performance web applications and REST APIs." },
      { name: "Vue.js", logo: VueJSLogo, level: "Advanced", years: "3+ years", detail: "Creating reactive and component-based user interfaces with Vue 3 and Composition API." },
      { name: "Astro", logo: AstroLogo, level: "Advanced", years: "1+ year", detail: "Building content-driven websites with modern island architecture for optimal performance." },
    ],
  },
  {
    category: "Databases",
    description: "Relational database management systems I use to ensure data integrity and high-performance querying.",
    items: [
      { name: "PostgreSQL", logo: PostgreSQLLogo, level: "Advanced", years: "3+ years", detail: "Experience with complex indexing, JSONB usage, and advanced performance tuning." },
      { name: "MySQL", logo: MySQLLogo, level: "Advanced", years: "4+ years", detail: "Robust experience in architecting and managing relational schemas for enterprise applications." },
    ],
  },
];
---

<SectionContainer bg="base">
  <SectionHeading
    eyebrow="The stack"
    title="Tools I ship with"
    description="Languages, frameworks, and databases I reach for in production — ranked by how deeply I've worked with them."
    accent="exp"
  />

  {detailedSkills.map((cat) => (
    <div class="mt-16">
      <!-- Category header -->
      <div class="flex flex-col gap-4 border-t border-ink/10 pt-10 md:flex-row md:items-start md:justify-between md:gap-16">
        <div class="flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-exp" aria-hidden="true"></span>
          <h2 class="font-display text-2xl font-semibold text-ink sm:text-3xl">{cat.category}</h2>
        </div>
        <p class="max-w-xl text-sm leading-relaxed text-ink-soft md:text-right">{cat.description}</p>
      </div>

      <!-- Skill cards -->
      <div class={`mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 ${cat.items.length > 3 ? "lg:grid-cols-4" : "lg:grid-cols-3"}`}>
        {cat.items.map((item) => (
          <div class="group flex flex-col rounded-3xl border border-ink/10 bg-base p-6 transition-all hover:-translate-y-1 hover:border-exp/40 hover:shadow-lg">
            <div class="flex items-center justify-between gap-3">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-ink/10 bg-surface transition-transform duration-300 group-hover:scale-110">
                <Image src={item.logo} alt={item.name} class="h-7 w-7 object-contain" />
              </div>
              <span class="rounded-full bg-exp-tint px-3 py-1 font-mono text-xs text-exp-deep">{item.level}</span>
            </div>

            <h3 class="mt-5 font-display text-lg font-semibold text-ink">{item.name}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{item.detail}</p>

            <div class="mt-6 flex items-center justify-between border-t border-ink/10 pt-4">
              <span class="font-mono text-xs text-ink-soft">{item.years}</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="text-exp opacity-40" aria-hidden="true">
                <path d="M7 1l1.8 4.2L13 5.2 9.6 7.8 10.9 12 7 9.4 3.1 12 4.4 7.8 1 5.2h5.2z" fill="currentColor" />
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</SectionContainer>