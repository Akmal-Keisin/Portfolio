---
import AstroLogo from "@assets/logos/astro-logo-light-gradient.svg";
import PHPLogo from "@assets/logos/php-logo.svg";
import GoLogo from "@assets/logos/go-logo.svg";
import GoFiberLogo from "@assets/logos/go-fiber-logo.svg";
import JavascriptLogo from "@assets/logos/javascript-logo.svg";
import VueJSLogo from "@assets/logos/vue-js-logo.svg";
import LaravelLogo from "@assets/logos/laravel-logo.svg";
import PostgreSQLLogo from "@assets/logos/postgresql-logo.svg";
import MySQLLogo from "@assets/logos/mysql-logo.svg";
import { Image } from "astro:assets";
import SectionContainer from "../../components/layout/SectionContainer.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";

const detailedSkills = [
  {
    category: "Languages",
    description: "The foundation of everything I ship. I care about type safety, performance, and clean syntax.",
    items: [
      { name: "PHP", logo: PHPLogo, level: "Advanced", years: "4+ years", detail: "Modern PHP 8 and up, focused on performance and robust backend systems." },
      { name: "Go", logo: GoLogo, level: "Advanced", years: "2+ years", detail: "High-concurrency services and fast API gateways." },
      { name: "JavaScript", logo: JavascriptLogo, level: "Advanced", years: "4+ years", detail: "Modern ES6+, TypeScript, and interactive frontend work." },
    ],
  },
  {
    category: "Frameworks",
    description: "Tools that help me build scalable applications faster without compromising on quality.",
    items: [
      { name: "Laravel", logo: LaravelLogo, level: "Expert", years: "4+ years", detail: "Deep working knowledge of Eloquent, queues, and the service container." },
      { name: "Go Fiber", logo: GoFiberLogo, level: "Advanced", years: "2+ years", detail: "Lightweight, high-performance web applications and REST APIs." },
      { name: "Vue.js", logo: VueJSLogo, level: "Advanced", years: "3+ years", detail: "Reactive, component-based interfaces with Vue 3 and the Composition API." },
      { name: "Astro", logo: AstroLogo, level: "Advanced", years: "1+ year", detail: "Content-driven sites using island architecture for fast page loads." },
    ],
  },
  {
    category: "Databases",
    description: "Relational systems I use to keep data consistent and queries fast.",
    items: [
      { name: "PostgreSQL", logo: PostgreSQLLogo, level: "Advanced", years: "3+ years", detail: "Complex indexing, JSONB usage, and query performance tuning." },
      { name: "MySQL", logo: MySQLLogo, level: "Advanced", years: "4+ years", detail: "Architecting and maintaining relational schemas for enterprise applications." },
    ],
  },
];
---

<SectionContainer id="stack" bg="base">
  <SectionHeading
    title="What I work with"
    description="Ranked by how much production time I have spent with each tool."
  />

  <div class="mt-12">
    {
      detailedSkills.map((cat) => (
        <section class="border-t border-ink/15 py-10 first:border-t-0 first:pt-0">
          <div class="flex items-baseline justify-between gap-6">
            <h2 class="font-display text-2xl font-semibold text-ink">{cat.category}</h2>
            <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">
              {cat.items.length} tools
            </span>
          </div>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-soft">{cat.description}</p>

          <ul class="mt-6 divide-y divide-ink/10 border-t border-ink/10">
            {cat.items.map((item) => (
              <li class="flex items-start gap-4 py-5">
                <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-ink/10 bg-surface">
                  <Image src={item.logo} alt="" class="h-6 w-6 object-contain" />
                </span>
                <div class="flex-1">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h3 class="font-display text-base font-semibold text-ink">{item.name}</h3>
                    <span class="font-mono text-xs text-ink-soft">
                      {item.level} / {item.years}
                    </span>
                  </div>
                  <p class="mt-1 max-w-xl text-sm leading-relaxed text-ink-soft">{item.detail}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</SectionContainer>
