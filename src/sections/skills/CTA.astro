---
import SectionContainer from "../../components/layout/SectionContainer.astro";
import Button from "../../components/ui/Button.astro";
---

<SectionContainer bg="ink">
  <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center">
    <h2 class="max-w-xl font-display text-3xl font-semibold tracking-tight text-band-ink sm:text-4xl">
      Got a problem this stack solves? Let's talk.
    </h2>
    <Button href="/contact" variant="inverted" class="shrink-0">Get in touch</Button>
  </div>
</SectionContainer>
