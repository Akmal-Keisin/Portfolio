---
import SocialIcon from "../../components/ui/SocialIcon.astro";
import Icon from "../../components/ui/Icon.astro";

const socialLinks = [
  { label: "GitHub", href: "https://github.com/akmal-keisin", icon: "github" },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/akmal-keisin-536102265/",
    icon: "linkedin",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/akmalkeisin_/",
    icon: "instagram",
  },
  { label: "Email", href: "mailto:helloakmalkeisin@gmail.com", icon: "mail" },
];
---

<aside class="space-y-6">
  <div class="rounded-2xl border border-ink/10 bg-surface p-8 text-center">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-canvas px-4 py-1.5 font-mono text-xs text-ink-soft"
    >
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      Available for projects
    </span>
    <h3 class="mt-5 font-display text-xl font-semibold text-ink">Current availability</h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
      I'm currently accepting new freelance projects and collaborations. My typical lead time is 2 to
      4 weeks.
    </p>
  </div>

  <div class="space-y-3">
    <h3 class="px-1 font-mono text-xs font-medium uppercase tracking-[0.2em] text-ink-soft">
      Connect elsewhere
    </h3>
    {
      socialLinks.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-xl border border-ink/10 bg-canvas px-5 py-4 transition-colors hover:border-folio/40 no-underline"
        >
          <div class="flex items-center gap-4">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-ink/10 bg-surface">
              <SocialIcon icon={social.icon as any} class="h-4 w-4 text-ink-soft" />
            </span>
            <span class="text-sm font-semibold text-ink transition-colors group-hover:text-folio-deep">
              {social.label}
            </span>
          </div>
          <Icon
            name="arrow-up-right"
            class="h-4 w-4 text-ink-soft transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      ))
    }
  </div>
</aside>
