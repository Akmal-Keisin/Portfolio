---
---
<section class="relative scroll-mt-20 overflow-hidden bg-base" aria-label="Get in touch">
  <!-- Ambient color field -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -left-24 -top-24 h-96 w-96 rounded-full bg-folio-tint blur-3xl"></div>
    <div class="absolute right-[-6rem] top-10 h-80 w-80 rounded-full bg-exp-tint blur-3xl"></div>
    <div class="absolute bottom-[-8rem] left-1/3 h-96 w-96 rounded-full bg-edu-tint blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-6 pb-20 pt-16 sm:px-8 sm:pt-24 lg:pt-28">
    <p class="font-mono text-sm uppercase tracking-[0.3em] text-ink-soft">
      Get In Touch
    </p>

    <h1 class="mt-4 max-w-3xl font-display text-5xl font-semibold leading-[1.1] text-ink sm:text-6xl">
      Let's start a <em class="italic text-folio-deep">conversation</em>
    </h1>

    <div class="mt-6 max-w-2xl">
      <p class="text-lg leading-relaxed text-ink-soft">
        Whether you have a project in mind, a question about my work, or just want to say hi — I'd love to hear from you.
      </p>
    </div>
  </div>
</section>