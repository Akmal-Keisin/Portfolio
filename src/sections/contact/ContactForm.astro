---
---
<section class="relative overflow-hidden rounded-3xl border border-ink/10 bg-base p-6 shadow-sm sm:p-10">
  <div class="pointer-events-none absolute right-0 top-0 h-40 w-40 rounded-tr-3xl bg-folio-tint blur-2xl" aria-hidden="true"></div>

  <h2 class="relative font-display text-2xl font-semibold text-ink sm:text-3xl">
    Send a message
  </h2>
  <p class="relative mt-2 text-sm text-ink-soft">
    I read every message myself and usually reply within a day or two.
  </p>

  <div id="form-feedback" class="mt-6 hidden rounded-2xl p-4 text-sm"></div>

  <form id="contact-form" class="relative mt-8 space-y-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="name" class="mb-1.5 block text-sm font-medium text-ink">Your name *</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Jane Doe"
          class="w-full rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep focus:outline-none"
        />
      </div>
      <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-ink">Email address *</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="jane@example.com"
          class="w-full rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep focus:outline-none"
        />
      </div>
    </div>

    <div>
      <label for="subject" class="mb-1.5 block text-sm font-medium text-ink">Subject *</label>
      <input
        type="text"
        id="subject"
        name="subject"
        required
        placeholder="Project inquiry"
        class="w-full rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep focus:outline-none"
      />
    </div>

    <div>
      <label for="message" class="mb-1.5 block text-sm font-medium text-ink">Message *</label>
      <textarea
        id="message"
        name="message"
        rows="6"
        required
        placeholder="Tell me about your project..."
        class="w-full resize-none rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep focus:outline-none"
      ></textarea>
    </div>

    <button
      type="submit"
      disabled
      class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-exp-deep px-6 py-3 text-sm font-semibold text-base shadow-[0_4px_0_0_var(--color-ink)] transition-all duration-200 hover:translate-y-[2px] hover:bg-exp hover:shadow-[0_2px_0_0_var(--color-ink)] disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none disabled:hover:translate-y-0 disabled:hover:bg-exp-deep disabled:hover:shadow-none"
    >
      <span class="submit-text">Send Message</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
    </button>

    <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">
      Contact form is in progress — working on it.
    </p>
  </form>
</section>

<script>
  import { sendMessage } from "@lib/api";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const feedback = document.getElementById("form-feedback") as HTMLDivElement;
  const submitBtn = form?.querySelector("button[type='submit']") as HTMLButtonElement;
  const submitText = form?.querySelector(".submit-text") as HTMLSpanElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!form || !feedback || !submitBtn || !submitText) return;

    feedback.classList.add("hidden");
    feedback.classList.remove("bg-exp-tint", "text-exp-deep", "bg-folio-tint", "text-folio-deep");

    submitBtn.disabled = true;
    submitText.textContent = "Sending...";

    const formData = new FormData(form);
    const data = {
      name: formData.get("name") as string,
      email: formData.get("email") as string,
      subject: formData.get("subject") as string,
      message: formData.get("message") as string,
    };

    try {
      const result = await sendMessage(data);

      feedback.textContent = result.message;
      feedback.classList.add("bg-exp-tint", "text-exp-deep");
      feedback.classList.remove("hidden");
      form.reset();
    } catch (error) {
      feedback.textContent = error instanceof Error ? error.message : "Something went wrong. Please try again.";
      feedback.classList.add("bg-folio-tint", "text-folio-deep");
      feedback.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = "Send Message";
    }
  });
</script>