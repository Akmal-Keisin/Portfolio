---
import Icon from "../../components/ui/Icon.astro";
---

<section class="rounded-2xl border border-ink/10 bg-canvas p-6 sm:p-10">
  <h2 class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
    Tell me about your project
  </h2>
  <p class="mt-2 text-sm text-ink-soft">
    I read every message myself and usually reply within a day or two.
  </p>

  <div id="form-feedback" class="mt-6 hidden rounded-xl p-4 text-sm"></div>

  <form id="contact-form" class="mt-8 space-y-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="name" class="mb-1.5 block text-sm font-medium text-ink">Your name *</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Your full name"
          class="w-full rounded-lg border border-ink/15 bg-canvas px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft focus:border-accent"
        />
      </div>
      <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-ink">Email address *</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="you@example.com"
          class="w-full rounded-lg border border-ink/15 bg-canvas px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft focus:border-accent"
        />
      </div>
    </div>

    <div>
      <label for="subject" class="mb-1.5 block text-sm font-medium text-ink">Subject *</label>
      <input
        type="text"
        id="subject"
        name="subject"
        required
        placeholder="Project inquiry"
        class="w-full rounded-lg border border-ink/15 bg-canvas px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft focus:border-accent"
      />
    </div>

    <div>
      <label for="message" class="mb-1.5 block text-sm font-medium text-ink">Message *</label>
      <textarea
        id="message"
        name="message"
        rows="6"
        required
        placeholder="What are you building, and what do you need from me?"
        class="w-full resize-none rounded-lg border border-ink/15 bg-canvas px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft focus:border-accent"
      ></textarea>
    </div>

    <div aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none;">
      <label for="website">Leave this empty</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" value="" />
    </div>

    <button
      type="submit"
      class="inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-full bg-accent px-6 py-3 text-sm font-semibold text-on-accent shadow-[0_3px_0_0_var(--color-ink)] transition-all duration-200 hover:translate-y-[2px] hover:bg-accent-hover hover:shadow-[0_1px_0_0_var(--color-ink)] disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none disabled:hover:translate-y-0 disabled:hover:bg-accent disabled:hover:shadow-none"
    >
      <span class="submit-text">Send message</span>
      <Icon name="send" class="h-4 w-4" />
    </button>
  </form>
</section>

<script>
  import { sendMessage } from "@lib/api";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const feedback = document.getElementById("form-feedback") as HTMLDivElement;
  const submitBtn = form?.querySelector("button[type='submit']") as HTMLButtonElement;
  const submitText = form?.querySelector(".submit-text") as HTMLSpanElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!form || !feedback || !submitBtn || !submitText) return;

    feedback.classList.add("hidden");
    feedback.classList.remove("bg-exp-tint", "text-exp-deep", "bg-article-tint", "text-article-deep");

    submitBtn.disabled = true;
    submitText.textContent = "Sending...";

    const formData = new FormData(form);
    const data = {
      name: formData.get("name") as string,
      email: formData.get("email") as string,
      subject: formData.get("subject") as string,
      message: formData.get("message") as string,
      website: formData.get("website") as string,
    };

    try {
      const result = await sendMessage(data);

      feedback.textContent = result.message;
      feedback.classList.add("bg-exp-tint", "text-exp-deep");
      feedback.classList.remove("hidden");
      form.reset();
    } catch (error) {
      feedback.textContent =
        error instanceof Error ? error.message : "Something went wrong. Please try again.";
      feedback.classList.add("bg-article-tint", "text-article-deep");
      feedback.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = "Send message";
    }
  });
</script>
