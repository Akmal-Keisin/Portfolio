---

<section id="contact" class="py-28 bg-fog-200 relative overflow-hidden">
  <!-- Decorative -->
  <div
    class="absolute bottom-0 right-0 w-125 h-125 rounded-full bg-mint/20 blur-3xl pointer-events-none z-0"
  >
  </div>

  <div class="relative max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="reveal mb-16 text-center max-w-2xl mx-auto">
      <span class="accent-line mx-auto mb-4"></span>
      <p class="font-mono text-xs text-moss-400 tracking-[.2em] uppercase mt-4">
        Contact
      </p>
      <h2 class="font-display text-5xl md:text-6xl font-semibold text-ink mt-3">
        Let's work<br /><em class="text-moss-500">together</em>
      </h2>
      <p class="font-body text-moss-600 mt-5 leading-relaxed">
        I'm currently open to full-time roles and select freelance projects.
        Reach out and I'll reply within one business day.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-10 items-start">
      <!-- Left -->
      <div class="reveal reveal-d1 space-y-8">
        <!-- Direct contact -->
        <div
          class="bg-white/70 border border-moss-100 rounded-2xl p-7 shadow-sm space-y-5"
        >
          <h3 class="font-display text-lg font-semibold text-moss-700">
            Get in touch
          </h3>
          {
            [
              {
                icon: "✉",
                label: "Email",
                value: "akmalkeisin@gmail.com",
                href: "mailto:akmalkeisin@gmail.com",
              },
              {
                icon: "☎",
                label: "Available",
                value: "Mon–Fri, 9–18 Asia/Jakarta",
                href: null,
              },
              {
                icon: "📍",
                label: "Location",
                value: "Semarang, Indonesia",
                href: null,
              },
            ].map((item) => (
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-mint/50 flex items-center justify-center text-lg shrink-0">
                  {item.icon}
                </div>
                <div>
                  <div class="font-mono text-xs text-moss-400 mb-0.5">
                    {item.label}
                  </div>
                  {item.href ? (
                    <a
                      href={item.href}
                      class="font-body text-sm font-semibold text-moss-700 hover:text-moss-500 transition-colors"
                    >
                      {item.value}
                    </a>
                  ) : (
                    <div class="font-body text-sm font-semibold text-moss-700">
                      {item.value}
                    </div>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Social -->
      <div class="bg-white/70 border border-moss-100 rounded-2xl p-7 shadow-sm">
        <h3 class="font-display text-base font-semibold text-moss-700 mb-5">
          Connect
        </h3>
        <div class="space-y-3">
          {
            [
              {
                name: "GitHub",
                handle: "Akmal-Keisin",
                link: "https://github.com/Akmal-Keisin",
                color: "bg-ink",
                icon: "GH",
              },
              {
                name: "LinkedIn",
                handle: "Akmal Keisin",
                link: "https://www.linkedin.com/in/akmal-keisin-536102265",
                color: "bg-moss-600",
                icon: "in",
              },
              {
                name: "Instagram",
                handle: "@this_is_keiii",
                link: "https://www.instagram.com/this_is_keiii",
                color: "bg-moss-400",
                icon: "IG",
              },
            ].map((s) => (
              <a
                href={s.link}
                class="flex items-center gap-3 group"
                target="_blank"
              >
                <div
                  class={`w-9 h-9 rounded-lg ${s.color} flex items-center justify-center shrink-0`}
                >
                  <span class="font-mono text-xs text-white font-bold">
                    {s.icon}
                  </span>
                </div>
                <div>
                  <span class="font-body text-sm font-medium text-moss-700 group-hover:text-moss-500 transition-colors">
                    {s.name}
                  </span>
                  <span class="font-mono text-xs text-moss-400 ml-2">
                    {s.handle}
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Right: Form -->
