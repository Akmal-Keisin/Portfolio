---
import { profile } from "../../data/profile";
import SectionContainer from "../layout/SectionContainer.astro";
import Button from "../ui/Button.astro";
import SocialIcon from "../ui/SocialIcon.astro";
---

<SectionContainer id="contact" bg="ink">
  <div class="grid gap-14 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start">
    <div>
      <div class="inline-flex items-center gap-2 font-mono text-xs font-medium uppercase tracking-[0.2em] text-base/50">
        <span class="h-2 w-2 rounded-full bg-folio" aria-hidden="true"></span>
        Get In Touch
      </div>
      <h2 class="mt-3 font-display text-3xl font-semibold text-base sm:text-4xl">
        Let's start a conversation
      </h2>
      <p class="mt-4 max-w-md text-base text-base/60">
        Currently open to new projects and interesting collaborations. Feel free
        to reach out if you have something in mind.
      </p>

      <div class="mt-8 space-y-3">
        <a
          href={`mailto:${profile.email}`}
          class="flex items-center gap-3 text-base/90 hover:text-base"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-base/10">
            <SocialIcon icon="mail" class="h-4 w-4" />
          </span>
          {profile.email}
        </a>
      </div>

      <div class="mt-6 flex gap-3">
        {
          profile.socials
            .filter((s) => s.icon !== "mail")
            .map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                class="flex h-10 w-10 items-center justify-center rounded-full bg-base/10 text-base/70 transition-colors hover:bg-folio hover:text-ink"
              >
                <SocialIcon icon={social.icon as any} class="h-4 w-4" />
              </a>
            ))
        }
      </div>
    </div>

    <form class="rounded-3xl bg-base p-8" aria-label="Contact form">
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-medium text-ink sm:col-span-1">
          Name
          <input
            type="text"
            name="name"
            required
            class="mt-1.5 w-full rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep"
            placeholder="Jane Doe"
          />
        </label>

        <label class="block text-sm font-medium text-ink sm:col-span-1">
          Email
          <input
            type="email"
            name="email"
            required
            class="mt-1.5 w-full rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep"
            placeholder="jane@email.com"
          />
        </label>

        <label class="block text-sm font-medium text-ink sm:col-span-2">
          Message
          <textarea
            name="message"
            required
            rows="4"
            class="mt-1.5 w-full rounded-xl border border-ink/15 bg-base px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-folio-deep"
            placeholder="Tell me a bit about your project..."
          ></textarea>
        </label>
      </div>

      <Button type="submit" variant="primary" class="mt-6 w-full sm:w-auto" disabled>
        Send message
      </Button>

      <p class="mt-3 font-mono text-xs uppercase tracking-widest text-base/50">
        Contact form is in progress — working on it.
      </p>

      <!--
        This form has no backend wired up yet. Point the `action` attribute
        at your form provider of choice (Formspree, Resend, a serverless
        function, etc.) when you're ready to receive submissions.
      -->
    </form>
  </div>
</SectionContainer>
