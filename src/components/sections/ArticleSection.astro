---
import { articles } from "../../data/articles";
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
import ArticleCard from "../cards/ArticleCard.astro";
import Button from "../ui/Button.astro";
---

<SectionContainer id="article" bg="base">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <SectionHeading
      eyebrow="Writing"
      title="From the articles"
      description="Notes on design systems, freelancing, and the occasional rabbit hole."
      accent="article"
    />
    <Button href="/article" variant="ghost">See all articles →</Button>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {articles.map((post) => <ArticleCard post={post} />)}
  </div>
</SectionContainer>