---
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";
import type { Project } from "../../lib/api";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusVariant =
  ({ completed: "exp", ongoing: "folio", archived: "neutral" } as const)[
    project.status
  ] ?? "neutral";
---

<article
  class="group flex flex-col overflow-hidden rounded-2xl border border-ink/10 bg-canvas transition-colors hover:border-folio/40"
>
  <a href={`/project/${project.slug}`} class="block overflow-hidden border-b border-ink/10">
    {
      project.thumbnail ? (
        <img
          src={project.thumbnail}
          alt={`Screenshot of ${project.title}`}
          loading="lazy"
          class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        />
      ) : (
        <div class="flex aspect-[16/10] items-center justify-center bg-surface p-6">
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-ink-soft">
            {project.tech_stacks[0]?.name ?? "Project"}
          </span>
        </div>
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between gap-3">
      <Badge variant="folio">{project.tech_stacks[0]?.name ?? "Project"}</Badge>
      <Badge variant={statusVariant}>{project.status}</Badge>
    </div>

    <h3 class="mt-4 font-display text-lg font-semibold text-ink">
      <a
        href={`/project/${project.slug}`}
        class="transition-colors group-hover:text-folio-deep"
      >
        {project.title}
      </a>
    </h3>

    <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{project.excerpt}</p>

    <a
      href={`/project/${project.slug}`}
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-folio-deep"
    >
      View project
      <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>
</article>
