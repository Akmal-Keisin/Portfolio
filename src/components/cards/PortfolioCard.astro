---
import Badge from "../ui/Badge.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import type { PortfolioEntry } from "../../data/portfolio";

interface Props {
  project: PortfolioEntry;
}

const { project } = Astro.props;
---

<article class="group overflow-hidden rounded-3xl border border-ink/10 bg-base transition-all hover:-translate-y-1 hover:border-folio/40 hover:shadow-lg">
  <a href={`/project/${project.slug}`} class="block">
    <div
      class="flex h-44 items-center justify-center bg-folio-tint bg-[radial-gradient(circle_at_30%_20%,var(--color-folio-tint),transparent_60%)] p-6"
    >
      <span class="font-display text-4xl font-semibold text-folio-deep/70">
        {project.title.slice(0, 1)}
      </span>
    </div>
  </a>

  <div class="p-6">
    <div class="flex items-center justify-between">
      <Badge variant="folio">{project.role}</Badge>
      <span class="font-mono text-xs text-ink-soft">{project.year}</span>
    </div>

    <h3 class="mt-4 font-display text-xl font-semibold text-ink">
      <a href={`/project/${project.slug}`} class="squiggle-underline text-folio-deep decoration-folio">
        {project.title}
      </a>
    </h3>

    <p class="mt-3 text-sm leading-relaxed text-ink-soft">{project.excerpt}</p>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-2">
        {project.tags.map((tag) => <Badge variant="neutral">{tag}</Badge>)}
      </div>
      <a
        href={`/project/${project.slug}`}
        class="inline-flex items-center gap-1 text-sm font-medium text-folio-deep transition-transform group-hover:translate-x-0.5"
      >
        View <SocialIcon icon="arrow-up-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </div>
</article>
