---
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";
import type { Article } from "../../sections/article/data";

interface Props {
  post: Article;
}

const { post } = Astro.props;

const formattedDate = new Date(post.createdAt).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<article
  class="group flex flex-col rounded-2xl border border-ink/10 bg-base p-6 transition-colors hover:border-article/40"
>
  <div class="flex items-center justify-between gap-3">
    <Badge variant="article">{post.category.name}</Badge>
    <time class="font-mono text-xs text-ink-soft" datetime={post.createdAt}>
      {formattedDate}
    </time>
  </div>

  <h3 class="mt-4 font-display text-lg font-semibold leading-snug text-ink">
    <a
      href={`/article/${post.slug}`}
      class="transition-colors group-hover:text-article-deep"
    >
      {post.title}
    </a>
  </h3>

  <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-ink-soft">
    {post.excerpt}
  </p>

  {
    post.tags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {post.tags.slice(0, 3).map((tag) => (
          <span class="font-mono text-xs text-ink-soft">#{tag.name}</span>
        ))}
      </div>
    )
  }

  <div class="mt-5 border-t border-ink/10 pt-4">
    <a
      href={`/article/${post.slug}`}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-article-deep"
    >
      Read article
      <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>
</article>
