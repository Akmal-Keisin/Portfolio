---
import Badge from "../ui/Badge.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import type { Article } from "../../sections/article/data";

interface Props {
  post: Article;
}

const { post } = Astro.props;

const formattedDate = new Date(post.createdAt).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<article class="group flex flex-col rounded-3xl border border-ink/10 bg-base p-6 transition-all hover:-translate-y-1 hover:border-article/40 hover:shadow-lg">
  <div class="flex items-center justify-between">
    <div class="flex flex-wrap gap-2">
      {post.tags.map((tag) => <Badge variant="article">{tag.name}</Badge>)}
    </div>
    <span class="font-mono text-xs text-ink-soft">{post.category.name}</span>
  </div>

  <h3 class="mt-5 font-display text-xl font-semibold leading-snug text-ink">
    <a href={`/article/${post.slug}`} class="squiggle-underline text-article-deep decoration-article">
      {post.title}
    </a>
  </h3>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">
    {post.excerpt}
  </p>

  <div class="mt-6 flex items-center justify-between border-t border-ink/10 pt-4">
    <time class="font-mono text-xs text-ink-soft" datetime={post.createdAt}>
      {formattedDate}
    </time>
    <a
      href={`/article/${post.slug}`}
      class="inline-flex items-center gap-1 text-sm font-medium text-article-deep transition-transform group-hover:translate-x-0.5"
    >
      Read article <SocialIcon icon="arrow-up-right" class="h-3.5 w-3.5" />
    </a>
  </div>
</article>