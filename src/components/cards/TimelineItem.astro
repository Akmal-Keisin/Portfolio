---
import Badge from "../ui/Badge.astro";
import type { BadgeVariant } from "../ui/Badge.astro";

interface Props {
  variant: Extract<BadgeVariant, "edu" | "exp">;
  title: string;
  subtitle: string;
  period: string;
  location?: string;
  summary: string;
  tags?: readonly string[];
  isLast?: boolean;
  href?: string;
}

const {
  variant,
  title,
  subtitle,
  period,
  location,
  summary,
  tags,
  isLast = false,
  href,
} = Astro.props;

const dotClass = variant === "edu" ? "bg-edu" : "bg-exp";
const lineClass = variant === "edu" ? "bg-edu-tint" : "bg-exp-tint";
---

<div class="relative flex gap-6 pb-10 last:pb-0">
  <div class="flex flex-col items-center">
    <span class:list={["mt-1.5 h-3.5 w-3.5 shrink-0 rounded-full ring-4 ring-base", dotClass]}></span>
    {!isLast && <span class:list={["mt-2 w-px flex-1", lineClass]}></span>}
  </div>

  <div class="flex-1">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="font-display text-xl font-semibold text-ink">
        {href ? <a href={href} class="hover:underline">{title}</a> : title}
      </h3>
      <span class="font-mono text-xs text-ink-soft">{period}</span>
    </div>
    <p class="mt-1 text-sm font-medium text-ink-soft">{subtitle}{location && <> · {location}</>}</p>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-soft">{summary}</p>
    {
      tags && tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <Badge variant={variant}>{tag}</Badge>
          ))}
        </div>
      )
    }
  </div>
</div>
