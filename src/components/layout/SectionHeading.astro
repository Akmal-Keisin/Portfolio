---
interface Props {
  title: string;
  description?: string;
  kicker?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  title,
  description,
  kicker,
  align = "left",
  class: className = "",
} = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center", className]}>
  {
    kicker && (
      <p class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink-soft">
        {kicker}
      </p>
    )
  }
  <h2
    class:list={[
      "font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl",
      kicker && "mt-3",
    ]}
  >
    {title}
  </h2>
  {description && <p class="mt-4 text-base leading-relaxed text-ink-soft">{description}</p>}
</div>
