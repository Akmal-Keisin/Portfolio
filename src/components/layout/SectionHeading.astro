---
import type { BadgeVariant } from "../ui/Badge.astro";

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  accent?: BadgeVariant;
  align?: "left" | "center";
}

const {
  eyebrow,
  title,
  description,
  accent = "neutral",
  align = "left",
} = Astro.props;

const accentDot: Record<BadgeVariant, string> = {
  edu: "bg-edu",
  exp: "bg-exp",
  folio: "bg-folio",
  article: "bg-article",
  neutral: "bg-ink-soft",
};
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]}>
  <div
    class:list={[
      "inline-flex items-center gap-2 font-mono text-xs font-medium uppercase tracking-[0.2em] text-ink-soft",
      align === "center" && "justify-center",
    ]}
  >
    <span class:list={["h-2 w-2 rounded-full", accentDot[accent]]} aria-hidden="true"></span>
    {eyebrow}
  </div>
  <h2 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">
    {title}
  </h2>
  {description && <p class="mt-4 text-base text-ink-soft">{description}</p>}
</div>
