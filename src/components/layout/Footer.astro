---
import { Image } from "astro:assets";
import PersonalLogo from "@assets/logos/personal-logo.webp";
import { profile } from "@data/profile";

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-surface">
  <div class="mx-auto max-w-6xl px-6 pt-12 pb-6 sm:px-8">
    <div class="flex flex-wrap items-start justify-between gap-8">
      <div>
        <a href="/" class="inline-flex items-center gap-3 font-display text-3xl font-semibold tracking-tight"><Image src={PersonalLogo} alt="" width={36} height={36} class="rounded-md" />{profile.name}</a>
        <p class="mt-2 text-sm text-ink-soft">{profile.role} · {profile.location}</p>
      </div>
      <div>
        <a href={`mailto:${profile.email}`} class="break-all text-sm text-accent underline underline-offset-4">{profile.email}</a>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {profile.socials.filter(({ icon }) => icon !== "mail").map((social) => (
            <li><a href={social.href} class="text-ink-soft hover:text-accent">{social.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-9 flex flex-wrap justify-between gap-4 border-t border-ink/10 pt-5 text-xs text-ink-soft">
      <p>© {year} {profile.name}</p>
      <a href="/rss.xml" class="underline underline-offset-4 hover:text-accent">RSS feed</a>
    </div>
  </div>
</footer>
