---
import { profile } from "../../data/profile";
import SocialIcon from "../ui/SocialIcon.astro";

const year = new Date().getFullYear();

const links = [
  { href: "/about", label: "About" },
  { href: "/skills", label: "Skills" },
  { href: "/project", label: "Projects" },
  { href: "/article", label: "Articles" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="border-t border-ink/10 bg-ink text-base/90">
  <div class="mx-auto max-w-6xl px-6 py-14 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href="/" class="font-display text-2xl font-semibold text-base">
          {profile.name}
        </a>
        <p class="mt-3 max-w-xs text-sm text-base/60">
          {profile.tagline}
        </p>
        <div class="mt-5 flex gap-3">
          {
            profile.socials.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                class="flex h-9 w-9 items-center justify-center rounded-full bg-base/10 text-base/70 transition-colors hover:bg-exp hover:text-ink"
              >
                <SocialIcon icon={social.icon as any} class="h-4 w-4" />
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest text-base/40">
          Navigate
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-base/70 hover:text-base">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest text-base/40">
          Get in touch
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm text-base/70">
          <li>{profile.location}</li>
          <li>
            <a href={`mailto:${profile.email}`} class="hover:text-base">
              {profile.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col-reverse items-start justify-between gap-4 border-t border-base/10 pt-6 text-xs text-base/40 sm:flex-row sm:items-center"
    >
      <p>© {year} {profile.name}. Built with Astro & Tailwind CSS.</p>
      <p class="font-mono">Designed &amp; coded in {profile.location}</p>
    </div>
  </div>
</footer>
