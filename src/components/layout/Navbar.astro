---
import { profile } from "../../data/profile";
import Icon from "../ui/Icon.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/skills", label: "Skills" },
  { href: "/project", label: "Projects" },
  { href: "/article", label: "Articles" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-canvas/95 backdrop-blur">
  <nav aria-label="Main navigation" class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3 sm:px-8">
    <a
      href="/"
      aria-label={`${profile.name}, home`}
      class="flex items-center gap-2.5 font-display text-lg font-bold tracking-tight"
    >
      <span class="flex size-9 items-center justify-center rounded-[.3rem] bg-signal font-mono text-lg font-bold text-[#19230d]" aria-hidden="true">&gt;_</span>
      <span>akmal<span class="text-accent">.</span>keisin</span>
    </a>

    <ul class="hidden items-center gap-6 text-sm lg:flex xl:gap-7">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "inline-flex min-h-11 items-center transition-colors hover:text-accent",
                isActive(link.href) ? "text-ink font-semibold underline decoration-accent decoration-2 underline-offset-8" : "text-ink-soft",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a href={profile.socials[0].href} aria-label="Akmal on GitHub" class="hidden size-11 items-center justify-center rounded-md border border-ink/15 text-ink-soft hover:text-accent lg:flex"><Icon name="github" class="size-4" /></a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-ink/15 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-ink/10 bg-canvas lg:hidden">
    <ul class="flex flex-col gap-1 px-6 py-4 font-mono text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "mobile-link block rounded-lg px-3 py-2.5 hover:bg-surface hover:text-ink",
                isActive(link.href) ? "text-ink font-semibold underline decoration-accent decoration-2 underline-offset-8" : "text-ink-soft",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      menu?.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      toggle.focus();
    }
  });

  // Theme switching. No stored choice means we follow the OS and keep following
  // it live; once the visitor picks a theme it is pinned and remembered.
  const root = document.documentElement;
  const mq = window.matchMedia("(prefers-color-scheme: dark)");
  const toggles = document.querySelectorAll("[data-theme-toggle]");

  const effectiveTheme = () => root.dataset.theme || (mq.matches ? "dark" : "light");

  const syncTheme = () => {
    const dark = effectiveTheme() === "dark";
    toggles.forEach((el) => {
      el.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
      el.setAttribute("aria-pressed", String(dark));
    });
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", dark ? "#10130f" : "#f8f9f4");
  };

  toggles.forEach((el) => {
    el.addEventListener("click", () => {
      const next = effectiveTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
      syncTheme();
    });
  });

  mq.addEventListener("change", syncTheme);
  syncTheme();
</script>
