---
import { profile } from "../../data/profile";
import { Image } from "astro:assets";
import PersonalLogo from "@assets/logos/personal-logo.webp";
import ThemeToggle from "../ui/ThemeToggle.astro";

const links = [
  { href: "/about", label: "About" },
  { href: "/skills", label: "Skills" },
  { href: "/project", label: "Projects" },
  { href: "/article", label: "Articles" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-canvas/85 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4 sm:px-8">
    <a
      href="/"
      class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight text-ink"
    >
      <span class="h-9 w-9 overflow-hidden rounded-full" aria-hidden="true">
        <Image src={PersonalLogo} width={36} height={36} alt="Akmal Keisin's logo" />
      </span>
      {profile.name}
    </a>

    <ul class="hidden items-center gap-6 font-mono text-sm lg:flex xl:gap-7">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "transition-colors hover:text-ink",
                isActive(link.href) ? "text-ink" : "text-ink-soft",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />

      <a
        href="/contact"
        class="hidden rounded-full bg-accent px-5 py-2.5 font-mono text-sm font-medium text-on-accent transition-colors hover:bg-accent-hover lg:inline-flex"
      >
        Get in touch
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-ink/10 bg-canvas lg:hidden">
    <ul class="flex flex-col gap-1 px-6 py-4 font-mono text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "mobile-link block rounded-lg px-3 py-2.5 hover:bg-surface hover:text-ink",
                isActive(link.href) ? "text-ink" : "text-ink-soft",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 border-t border-ink/10 pt-2">
        <ThemeToggle variant="menu" />
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });

  // Theme switching. No stored choice means we follow the OS and keep following
  // it live; once the visitor picks a theme it is pinned and remembered.
  const root = document.documentElement;
  const mq = window.matchMedia("(prefers-color-scheme: dark)");
  const toggles = document.querySelectorAll("[data-theme-toggle]");

  const effectiveTheme = () => root.dataset.theme || (mq.matches ? "dark" : "light");

  const syncTheme = () => {
    const dark = effectiveTheme() === "dark";
    toggles.forEach((el) => {
      el.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
      el.setAttribute("aria-pressed", String(dark));
    });
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", dark ? "#171613" : "#fafaf8");
  };

  toggles.forEach((el) => {
    el.addEventListener("click", () => {
      const next = effectiveTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
      syncTheme();
    });
  });

  mq.addEventListener("change", syncTheme);
  syncTheme();
</script>
