---

<footer class="bg-ink py-10">
  <div
    class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4"
  >
    <div class="flex items-center gap-2">
      <span class="font-display text-lg text-fog/80"
        >Keisin<span class="text-moss-400">.</span></span
      >
    </div>
    <p class="font-mono text-xs text-fog">
      © {new Date().getFullYear()} Akmal Keisin — Built with Astro & Tailwind
    </p>
    <div class="flex items-center gap-6">
      {["About", "Article", "Skills", "Projects", "Contact"].map((item) => (
        <a
          href={`/${item.toLowerCase() === "projects" ? "project" : item.toLowerCase()}`}
          class="font-mono text-[10px] text-moss-400 hover:text-mint transition-colors tracking-widest uppercase no-underline"
        >
          {item}
        </a>
      ))}
      <a
        href="/"
        class="font-mono text-xs text-moss-500 hover:text-mint transition-colors"
      >
        Back to Home ↑
      </a>
    </div>
  </div>
</footer>
