---
const articles = [
  {
    slug: "cooming-soon",
    tag: "Backend",
    date: "May 12, 2025",
    readTime: "0 min read",
    title: "Cooming Soon",
    excerpt:
      "Cooming Soon",
    featured: true,
  },
  {
    slug: "cooming-soon",
    tag: "Frontend",
    date: "Apr 28, 2025",
    readTime: "0 min read",
    title: "Cooming Soon",
    excerpt:
      "Cooming Soon",
    featured: false,
  },
  {
    slug: "cooming-soon",
    tag: "Frontend",
    date: "Apr 28, 2025",
    readTime: "0 min read",
    title: "Cooming Soon",
    excerpt:
      "Cooming Soon",
    featured: false,
  },
  {
    slug: "cooming-soon",
    tag: "Frontend",
    date: "Apr 28, 2025",
    readTime: "0 min read",
    title: "Cooming Soon",
    excerpt:
      "Cooming Soon",
    featured: false,
  },
];

const tagColors: Record<string, { bg: string; text: string; border: string }> = {
  Backend:      { bg: "bg-moss-700/60",  text: "text-mint",      border: "border-moss-500/50" },
  Frontend:     { bg: "bg-moss-700/60",  text: "text-mint",      border: "border-moss-500/50" },
  Database:     { bg: "bg-moss-700/60",  text: "text-mint",      border: "border-moss-500/50" },
  Architecture: { bg: "bg-moss-700/60",  text: "text-mint",      border: "border-moss-500/50" },
};

const featured = articles.find((a) => a.featured);
const rest = articles.filter((a) => !a.featured);
---

<section id="articles" class="py-28 bg-fog relative overflow-hidden">

  <!-- Watermark numeral -->
  <div
    class="absolute top-6 left-6 font-display text-[180px] leading-none select-none pointer-events-none text-moss-100"
    aria-hidden="true"
  >
    03
  </div>

  <!-- Subtle dot grid -->
  <div class="absolute inset-0 pointer-events-none opacity-[.07]" aria-hidden="true">
    <svg width="100%" height="100%">
      <defs>
        <pattern id="dots" x="0" y="0" width="28" height="28" patternUnits="userSpaceOnUse">
          <circle cx="1.5" cy="1.5" r="1.5" fill="#3e7d32" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#dots)" />
    </svg>
  </div>

  <div class="relative max-w-6xl mx-auto px-6">

    <!-- Section header -->
    <div class="reveal mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="accent-line mb-4"></span>
        <p class="font-mono text-xs text-moss-400 tracking-[.2em] uppercase mt-4">Writing</p>
        <h2 class="font-display text-5xl font-semibold text-ink mt-2">
          From the<br /><em class="text-moss-500">notebook</em>
        </h2>
      </div>
      <a
        href="/blog"
        class="self-end inline-flex items-center gap-2 font-body text-sm font-semibold text-moss-600 border-b-2 border-moss-200 hover:border-moss-500 transition-colors pb-0.5"
      >
        All articles
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <!-- Layout: featured left, stack right -->
    <div class="grid lg:grid-cols-[1fr_340px] gap-6 items-start">

      <!-- Featured article -->
      {featured && (
        <a
          href={`/blog/${featured.slug}`}
          class="reveal group relative flex flex-col justify-between rounded-2xl border border-moss-200 bg-white/70 p-8 overflow-hidden card-lift h-full min-h-100 hover:border-moss-400 transition-colors"
        >
          <!-- Decorative leaf watermark -->
          <svg
            class="absolute -bottom-8 -right-8 w-48 opacity-[.06] pointer-events-none transition-transform duration-500 group-hover:scale-110 group-hover:opacity-[.09]"
            viewBox="0 0 200 280"
            fill="none"
            aria-hidden="true"
          >
            <path d="M100 10C100 10 20 60 20 140C20 188 55 220 100 220C145 220 180 188 180 140C180 60 100 10 100 10Z" fill="#3e7d32" />
            <line x1="100" y1="220" x2="100" y2="270" stroke="#3e7d32" stroke-width="4" stroke-linecap="round" />
            <path d="M100 140L65 105" stroke="#c8f0d0" stroke-width="3" stroke-linecap="round" opacity=".6" />
            <path d="M100 160L130 125" stroke="#c8f0d0" stroke-width="3" stroke-linecap="round" opacity=".6" />
          </svg>

          <div>
            <!-- Top meta -->
            <div class="flex items-center gap-3 mb-6">
              <span class={`font-mono text-[10px] tracking-widest uppercase px-3 py-1 rounded-full border ${tagColors[featured.tag].bg} ${tagColors[featured.tag].text} ${tagColors[featured.tag].border}`}>
                {featured.tag}
              </span>
              <span class="font-mono text-[10px] text-moss-400 tracking-wide border border-moss-200 px-3 py-1 rounded-full bg-sage-100/40">
                Featured
              </span>
            </div>

            <!-- Title -->
            <h3 class="font-display text-3xl md:text-4xl font-semibold text-ink leading-tight mb-4 group-hover:text-moss-700 transition-colors">
              {featured.title}
            </h3>

            <!-- Excerpt -->
            <p class="font-body text-moss-600 leading-relaxed text-base max-w-lg">
              {featured.excerpt}
            </p>
          </div>

          <!-- Bottom meta -->
          <div class="flex items-center justify-between mt-8 pt-6 border-t border-moss-100">
            <div class="flex items-center gap-4">
              <span class="font-mono text-xs text-moss-400">{featured.date}</span>
              <span class="w-1 h-1 rounded-full bg-moss-300" aria-hidden="true"></span>
              <span class="font-mono text-xs text-moss-400">{featured.readTime}</span>
            </div>
            <div class="flex items-center gap-1.5 text-moss-500 group-hover:text-moss-700 transition-colors">
              <span class="font-body text-sm font-medium">Read</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
                class="group-hover:translate-x-1 transition-transform">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </div>
        </a>
      )}

      <!-- Secondary articles stack -->
      <div class="flex flex-col gap-4">
        {rest.map((article, i) => (
          <a
            href={`/blog/${article.slug}`}
            class={`reveal reveal-d${i + 1} group flex flex-col gap-3 rounded-2xl border border-moss-200 bg-white/70 p-6 card-lift hover:border-moss-400 transition-colors`}
          >
            <!-- Tag + date row -->
            <div class="flex items-center justify-between">
              <span class={`font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded-full border ${tagColors[article.tag].bg} ${tagColors[article.tag].text} ${tagColors[article.tag].border}`}>
                {article.tag}
              </span>
              <span class="font-mono text-[10px] text-moss-400">{article.readTime}</span>
            </div>

            <!-- Title -->
            <h3 class="font-display text-lg font-semibold text-ink leading-snug group-hover:text-moss-700 transition-colors">
              {article.title}
            </h3>

            <!-- Excerpt -->
            <p class="font-body text-sm text-moss-500 leading-relaxed line-clamp-2">
              {article.excerpt}
            </p>

            <!-- Date + arrow -->
            <div class="flex items-center justify-between pt-1">
              <span class="font-mono text-[10px] text-moss-400">{article.date}</span>
              <svg
                width="14" height="14" viewBox="0 0 14 14" fill="none"
                class="text-moss-400 group-hover:text-moss-600 group-hover:translate-x-1 transition-all"
                aria-hidden="true"
              >
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>