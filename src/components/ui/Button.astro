---
export type ButtonVariant = "primary" | "secondary" | "ghost" | "inverted";

interface Props {
  href?: string;
  variant?: ButtonVariant;
  class?: string;
  type?: "button" | "submit";
  disabled?: boolean;
}

const {
  href,
  variant = "primary",
  class: className = "",
  type = "button",
  disabled = false,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-6 py-3 text-sm font-semibold transition-all duration-200 focus-visible:outline-none";

const variantClasses: Record<ButtonVariant, string> = {
  primary:
    "bg-accent text-base shadow-[0_3px_0_0_var(--color-ink)] hover:bg-accent-hover hover:translate-y-[2px] hover:shadow-[0_1px_0_0_var(--color-ink)]",
  secondary:
    "border border-ink/25 bg-transparent text-ink hover:border-ink hover:bg-ink hover:text-base",
  ghost: "bg-transparent px-0 text-ink-soft hover:text-ink",
  inverted: "bg-base text-ink hover:bg-exp-tint",
};

const disabledClass = disabled
  ? "cursor-not-allowed opacity-50 shadow-none hover:translate-y-0 hover:bg-accent hover:shadow-none"
  : "";

const classes = [base, variantClasses[variant], className, disabledClass].join(" ");

const Tag = href ? "a" : "button";
---

<Tag
  class={classes}
  href={disabled ? undefined : href}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  aria-disabled={disabled}
>
  <slot />
</Tag>
