---
export type ButtonVariant = "primary" | "secondary" | "ghost" | "inverted";

interface Props {
  href?: string;
  variant?: ButtonVariant;
  class?: string;
  type?: "button" | "submit";
  disabled?: boolean;
}

const {
  href,
  variant = "primary",
  class: className = "",
  type = "button",
  disabled = false,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 whitespace-nowrap min-h-11 rounded-[0.3rem] px-5 py-3 text-sm font-semibold transition-colors duration-200";

const variantClasses: Record<ButtonVariant, string> = {
  primary:
    "bg-signal text-[#18220c] hover:bg-[#c9fc7e]",
  secondary:
    "border border-ink/25 bg-transparent text-ink hover:border-ink hover:bg-ink hover:text-canvas",
  ghost: "bg-transparent px-0 text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent",
  inverted: "bg-band-ink text-band hover:bg-band-ink/85",
};

const disabledClass = disabled
  ? "cursor-not-allowed opacity-50 shadow-none hover:translate-y-0 hover:bg-accent hover:shadow-none"
  : "";

const classes = [base, variantClasses[variant], className, disabledClass].join(" ");

const Tag = href ? "a" : "button";
---

<Tag
  class={classes}
  href={disabled ? undefined : href}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  aria-disabled={disabled}
>
  <slot />
</Tag>
